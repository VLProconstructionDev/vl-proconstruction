# Copy to .env and fill in real values. .env is gitignored; this file is not.

# Sentry build-time auth token — uploads source maps so stack traces are
# readable in the dashboard. Create at: Sentry → Settings → Auth Tokens
# (scopes: project:releases). Also set as a Cloudflare Pages build env var.
# Without it, builds still succeed but skip the source-map upload.
SENTRY_AUTH_TOKEN=
