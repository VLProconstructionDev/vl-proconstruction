# Cloudflare Pages headers (https://developers.cloudflare.com/pages/configuration/headers/)
# Astro's hashed build assets never change under the same URL — cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Media/images/video aren't content-hashed but are replaced under NEW names
# in practice (e.g. hero-0715) — 30 days is safe and fixes the "no cache TTL"
# audit (uncached looping video can even be re-fetched mid-session).
/assets/*
  Cache-Control: public, max-age=2592000

# Email-client images (the lead-magnet guide email). Gmail/Outlook proxy these
# through their own image cache, so a long TTL just saves origin hits. Replace
# under a NEW filename if the logo ever changes.
/email/*
  Cache-Control: public, max-age=2592000

# Lead-magnet PDF linked from the guide email. Shorter TTL than /assets/*
# because the guide may be revised under the same filename.
/guides/*
  Cache-Control: public, max-age=86400

# Robots directives as a response header as well as the <meta name="robots">
# tag SEO.astro emits — some crawlers and auditors read only the header, and
# it is the only way to state them for non-HTML files (the OG card, the PDF).
# Deliberately the only X-Robots-Tag rule: Cloudflare APPENDS a more specific
# rule's header rather than replacing it, so a `/404  X-Robots-Tag: noindex`
# block made that one URL answer with two conflicting values. The 404 page
# carries <meta name="robots" content="noindex, nofollow"> and is served with
# a 404 status, so it is covered without a header of its own.
/*
  X-Robots-Tag: index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1
