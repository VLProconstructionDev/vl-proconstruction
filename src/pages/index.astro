  <script is:inline>
    // Shared reduced-motion flag used by the hero rotator, count-up, parallax,
    // and reviews carousel below.
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Hero service rotator — cycles the brand-colored line through our core services.
    // Starts on the visitor's first interaction (not on load): every swap repaints
    // the biggest text on screen, and swaps BEFORE any input keep pushing the
    // page's LCP later — Lighthouse/CrUX read the last swap, not the real load.
    // Interaction ends LCP observation, so rotating after it is free; a fallback
    // timer still starts the show for completely motionless visitors.
    const rotator = document.getElementById('heroRotator');
    if (rotator) {
      const br = '<br class="sm:hidden" />';
      const services = ['Custom ' + br + 'Showers', 'Tile &amp; Natural ' + br + 'Stone', 'Hard Surface ' + br + 'Flooring'];
      let si = 0;
      let started = false;
      const startRotator = () => {
        if (started) return;
        started = true;
        setInterval(() => {
          si = (si + 1) % services.length;
          if (reduceMotion) { rotator.innerHTML = services[si]; return; }
          rotator.classList.add('is-out');
          setTimeout(() => {
            rotator.innerHTML = services[si];
            rotator.classList.remove('is-out');
          }, 350);
        }, 3000);
      };
      ['pointerdown', 'pointermove', 'wheel', 'touchstart', 'keydown', 'scroll'].forEach((ev) =>
        window.addEventListener(ev, startRotator, { once: true, passive: true })
      );
      setTimeout(startRotator, 12000);
    }

    // Count-up animation for stats (runs when each number scrolls into view)
    const nums = document.querySelectorAll('.stat-num');
    const fmt = (val, dec) => dec ? val.toFixed(dec) : String(Math.round(val));
    const runCount = (el) => {
      const target = parseFloat(el.dataset.count);
      const dec = (el.dataset.count.split('.')[1] || '').length;
      const duration = 1500;
      let startTime = null;
      const tick = (now) => {
        if (startTime === null) startTime = now;
        const p = Math.min((now - startTime) / duration, 1);
        const eased = 1 - Math.pow(1 - p, 3); // easeOutCubic
        el.textContent = fmt(target * eased, dec);
        if (p < 1) requestAnimationFrame(tick);
        else el.textContent = fmt(target, dec);
      };
      requestAnimationFrame(tick);
    };

    if (reduceMotion || !('IntersectionObserver' in window)) {
      nums.forEach((el) => { el.textContent = fmt(parseFloat(el.dataset.count), (el.dataset.count.split('.')[1] || '').length); });
    } else {
      nums.forEach((el) => { el.textContent = fmt(0, (el.dataset.count.split('.')[1] || '').length); });
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { runCount(e.target); io.unobserve(e.target); }
        });
      }, { threshold: 0.6 });
      nums.forEach((el) => io.observe(el));
    }

    // Vertical auto-scrolling photo wall (home-page build: swaps columns 1 and 3)
    const wall = document.getElementById('galleryWall');
    if (wall) {
      // Real job photos, Aug 2026 client sets — the three service galleries
      // (flooring / custom showers / tile & natural stone) interleaved so no
      // column of the wall reads as one single trade.
      const photos = [
        '/assets/images/gallery-flooring/flooring-1.webp',
        '/assets/images/gallery-showers-2026/showers-1.webp',
        '/assets/images/gallery-tile-2026/tile-1.webp',
        '/assets/images/gallery-flooring/flooring-2.webp',
        '/assets/images/gallery-showers-2026/showers-2.webp',
        '/assets/images/gallery-tile-2026/tile-2.webp',
        '/assets/images/gallery-flooring/flooring-3.webp',
        '/assets/images/gallery-showers-2026/showers-3.webp',
        '/assets/images/gallery-tile-2026/tile-3.webp',
        '/assets/images/gallery-flooring/flooring-4.webp',
        '/assets/images/gallery-showers-2026/showers-4.webp',
        '/assets/images/gallery-tile-2026/tile-4.webp',
        '/assets/images/gallery-flooring/flooring-5.webp',
        '/assets/images/gallery-showers-2026/showers-5.webp',
        '/assets/images/gallery-tile-2026/tile-5.webp',
        '/assets/images/gallery-flooring/flooring-6.webp',
        '/assets/images/gallery-showers-2026/showers-6.webp',
        '/assets/images/gallery-tile-2026/tile-6.webp',
        '/assets/images/gallery-flooring/flooring-7.webp',
        '/assets/images/gallery-showers-2026/showers-7.webp',
        '/assets/images/gallery-flooring/flooring-8.webp',
        '/assets/images/gallery-showers-2026/showers-8.webp',
        '/assets/images/gallery-flooring/flooring-9.webp',
        '/assets/images/gallery-showers-2026/showers-9.webp',
        '/assets/images/gallery-flooring/flooring-10.webp',
        '/assets/images/gallery-showers-2026/showers-10.webp',
        '/assets/images/gallery-showers-2026/showers-11.webp',
        '/assets/images/gallery-showers-2026/showers-12.webp',
      ];
      const durations = [40, 32, 46, 36, 42];
      const colsFor = (w) => (w >= 1024 ? 5 : w >= 640 ? 3 : 2);
      let built = 0;
      const cell = (src) =>
        `<div class="vcell overflow-hidden aspect-[4/5]"><img src="${src}" alt="VL Proconstruction project" loading="lazy" class="gallery-img w-full h-full object-cover"/></div>`;
      const build = () => {
        const n = colsFor(window.innerWidth);
        if (n === built && wall.childElementCount) return;
        built = n;
        const cols = Array.from({ length: n }, () => []);
        const total = Math.max(photos.length, n * 3);
        for (let i = 0; i < total; i++) cols[i % n].push(photos[i % photos.length]);
        // Home-page-only swap: column 1 and column 3 photos so the wall opens on a different mix.
        if (n >= 3) { const swap = cols[0]; cols[0] = cols[2]; cols[2] = swap; }
        wall.innerHTML = cols
          .map((imgs, ci) => {
            const set = imgs.map(cell).join('');
            const dir = ci % 2 ? ' vcol-down' : '';
            const dur = durations[ci % durations.length];
            return `<div class="vcol${dir}" style="animation-duration:${dur}s">${set}${set}</div>`;
          })
          .join('');
      };
      // Build only when the wall approaches the viewport — building at page
      // load makes the browser fetch every wall photo immediately (dozens of
      // requests, several MB), starving the above-fold content on mobile.
      // `loading="lazy"` doesn't save us here: mobile lazy thresholds are
      // thousands of px, and the cells sit inside animated columns.
      let wallReady = false;
      const buildOnce = () => {
        if (wallReady) return;
        wallReady = true;
        build();
        let resizeT;
        window.addEventListener('resize', () => { clearTimeout(resizeT); resizeT = setTimeout(build, 200); }, { passive: true });
      };
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            if (entries.some((e) => e.isIntersecting)) {
              io.disconnect();
              buildOnce();
            }
          },
          { rootMargin: '1200px 0px' }
        );
        io.observe(wall);
      } else {
        buildOnce();
      }
    }

    // Parallax process photos — each image drifts within its frame as the section scrolls
    const pxImgs = [...document.querySelectorAll('.px-img')];
    if (pxImgs.length && !reduceMotion) {
      let ticking = false;
      const renderParallax = () => {
        const vh = window.innerHeight;
        pxImgs.forEach((img) => {
          const frame = img.parentElement;
          const r = frame.getBoundingClientRect();
          if (r.bottom < 0 || r.top > vh) return;
          const progress = (r.top + r.height / 2 - vh / 2) / (vh / 2 + r.height / 2);
          const shift = frame.offsetHeight * 0.20;
          img.style.transform = `translateY(${(progress * shift).toFixed(1)}px)`;
        });
        ticking = false;
      };
      const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(renderParallax); } };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      renderParallax();
    }

    // Reviews quote carousel
    const revQuote = document.getElementById('revQuote');
    if (revQuote) {
      // TODO: real Google reviews
      const reviews = [
        { name: 'Paul Lipowicz', role: '', quote: "Abel and his brothers are top notch installers. I have been in the industry for 20 years and know great installers when I see them. I hired them to do a marble backsplash for me and they were extremely clean, calculated, presentable, and meticulous. They do things right the first time and take pride in their knowledge and work. Definitely will be using them again soon on other properties!", img: '/assets/images/review-1.webp', avatar: '/assets/images/review-1-avatar.webp' },
        { name: 'Valeriy Tsinovkin', role: '', quote: "I recently had my kitchen remodeled and couldn't be happier with the results. The entire process was smooth and professional, and the team kept everything clean and organized throughout the project. The craftsmanship and attention to detail were excellent, and my kitchen looks stunning. Highly recommend to anyone looking for a high-quality, hassle-free remodel.", img: '/assets/images/review-2.webp', avatar: '/assets/images/review-2-avatar.webp' },
        { name: 'Avetal Mor', role: '', quote: "Absolutely amazing work fixed our floors after hurricane!", img: '/assets/images/review-3.webp', avatar: '/assets/images/review-3-avatar.webp' },
        { name: 'Stacy Ramirez', role: '', quote: "Vlad and his team are phenomenal! We couldn't be happier with our new master bath. Their attention to detail is unmatched. They showed up, communicated well, and offered quality suggestions. We highly recommend and will use them for our next home project.", img: '/assets/images/review-4.webp', avatar: '/assets/images/review-4-avatar.webp' },
      ];
      const revName = document.getElementById('revName');
      const revRole = document.getElementById('revRole');
      const revImg = document.getElementById('revImg');
      const revAvatar = document.getElementById('revAvatar');
      const fades = [document.getElementById('revMeta'), revQuote.closest('.rev-fade'), revImg.closest('.rev-fade')];
      let i = 0;
      const paint = () => {
        const r = reviews[i];
        revName.textContent = r.name;
        revRole.textContent = r.role;
        revRole.classList.toggle('hidden', !r.role);
        revQuote.textContent = r.quote;
        revImg.src = r.img;
        revAvatar.src = r.avatar;
        syncDots();
      };
      const quoteCol = revQuote.closest('.rev-fade').parentElement;
      const lockHeight = () => {
        const current = reviews[i].quote;
        quoteCol.style.minHeight = '';
        let max = 0;
        reviews.forEach((r) => { revQuote.textContent = r.quote; max = Math.max(max, quoteCol.offsetHeight); });
        revQuote.textContent = current;
        quoteCol.style.minHeight = max + 'px';
      };
      const dotsWrap = document.getElementById('revDots');
      let dots = [];
      const syncDots = () => dots.forEach((d, n) => {
        d.classList.toggle('is-active', n === i);
        d.setAttribute('aria-current', n === i ? 'true' : 'false');
      });
      let animating = false;
      const go = (dir) => {
        if (animating) return;
        i = (i + dir + reviews.length) % reviews.length;
        if (reduceMotion) { paint(); return; }
        animating = true;
        const outX = dir > 0 ? -36 : 36;
        const inX = dir > 0 ? 36 : -36;
        fades.forEach((el) => { el.style.opacity = '0'; el.style.transform = `translateX(${outX}px)`; });
        setTimeout(() => {
          paint();
          fades.forEach((el) => { el.style.transition = 'none'; el.style.transform = `translateX(${inX}px)`; });
          void document.body.offsetWidth;
          requestAnimationFrame(() => {
            fades.forEach((el) => { el.style.transition = ''; el.style.opacity = '1'; el.style.transform = 'translateX(0)'; });
            setTimeout(() => { animating = false; }, 450);
          });
        }, 350);
      };
      let timer = null;
      const start = () => { timer = setInterval(() => go(1), 5000); };
      const reset = () => { clearInterval(timer); start(); };
      document.getElementById('revPrev').addEventListener('click', () => { go(-1); reset(); });
      document.getElementById('revNext').addEventListener('click', () => { go(1); reset(); });
      const reviewsSection = document.getElementById('reviews');
      reviewsSection.addEventListener('mouseenter', () => clearInterval(timer));
      reviewsSection.addEventListener('mouseleave', start);
      let touchX = null, touchY = null;
      reviewsSection.addEventListener('touchstart', (e) => {
        touchX = e.changedTouches[0].clientX;
        touchY = e.changedTouches[0].clientY;
      }, { passive: true });
      reviewsSection.addEventListener('touchend', (e) => {
        if (touchX === null) return;
        const dx = e.changedTouches[0].clientX - touchX;
        const dy = e.changedTouches[0].clientY - touchY;
        touchX = touchY = null;
        if (Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(dy)) return;
        go(dx < 0 ? 1 : -1);
        reset();
      }, { passive: true });
      lockHeight();
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(lockHeight);
      let resizeT = null;
      window.addEventListener('resize', () => { clearTimeout(resizeT); resizeT = setTimeout(lockHeight, 150); }, { passive: true });
      if (dotsWrap) {
        dots = reviews.map((r, n) => {
          const d = document.createElement('button');
          d.type = 'button';
          d.className = 'rev-dot';
          d.setAttribute('role', 'tab');
          d.setAttribute('aria-label', 'Show review ' + (n + 1) + ' of ' + reviews.length);
          d.addEventListener('click', () => { if (n !== i) { go(n - i); reset(); } });
          dotsWrap.appendChild(d);
          return d;
        });
        syncDots();
      }
      start();
    }

    // Partner logo marquee — varied wordmark styling reads as a row of logos
    const logoTrack = document.getElementById('logoTrack');
    if (logoTrack) {
      // TODO: real partner / supplier logos (swap wordmarks for <img> when available)
      const brands = [
        { name: 'SCHLUTER', cls: 'font-bold tracking-[0.04em]' },
        { name: 'DALTILE', cls: 'font-serifd font-semibold tracking-[0.12em]' },
        { name: 'KOHLER', cls: 'font-semibold tracking-[0.32em]' },
        { name: 'MOEN', cls: 'font-bold tracking-[0.06em]' },
        { name: 'MARAZZI', cls: 'font-serifd tracking-[0.05em]' },
        { name: 'MOHAWK', cls: 'font-bold tracking-[0.18em]' },
        { name: 'MSI', cls: 'font-bold tracking-[0.2em]' },
        { name: 'BOSTIK', cls: 'font-semibold tracking-[0.14em]' },
      ];
      const span = (b) =>
        `<span class="logo-item ${b.cls} text-[clamp(1.05rem,1.7vw,1.65rem)]">${b.name}</span>`;
      const set = brands.map(span).join('');
      logoTrack.innerHTML = set + set;
    }

    // FAQ accordion — single-open; content stays visible if JS is unavailable
    const faqList = document.getElementById('faqList');
    if (faqList) {
      faqList.classList.add('js-faq');
      const items = [...faqList.querySelectorAll('.faq-item')].map((item) => ({
        q: item.querySelector('.faq-q'),
        a: item.querySelector('.faq-a'),
      }));
      const collapse = (it) => { it.q.setAttribute('aria-expanded', 'false'); it.a.style.height = '0px'; };
      const expand = (it) => { it.q.setAttribute('aria-expanded', 'true'); it.a.style.height = it.a.scrollHeight + 'px'; };
      items.forEach((it) => {
        collapse(it);
        it.q.addEventListener('click', () => {
          const isOpen = it.q.getAttribute('aria-expanded') === 'true';
          items.forEach(collapse);
          if (!isOpen) expand(it);
        });
      });
      window.addEventListener('resize', () => {
        const open = items.find((it) => it.q.getAttribute('aria-expanded') === 'true');
        if (open) open.a.style.height = open.a.scrollHeight + 'px';
      }, { passive: true });
    }

    // Before / After slider — press anywhere and drag; the divider follows the pointer
    document.querySelectorAll('.ba').forEach((el) => {
      let pos = 50;
      let dragging = false;
      const set = (pct) => {
        pos = Math.max(0, Math.min(100, pct));
        el.style.setProperty('--pos', pos + '%');
        el.setAttribute('aria-valuenow', Math.round(pos));
      };
      const setFromX = (clientX) => {
        const r = el.getBoundingClientRect();
        set(((clientX - r.left) / r.width) * 100);
      };
      el.addEventListener('pointerdown', (e) => {
        dragging = true; setFromX(e.clientX); el.setPointerCapture(e.pointerId); e.preventDefault();
      });
      el.addEventListener('pointermove', (e) => { if (dragging) setFromX(e.clientX); });
      el.addEventListener('pointerup', () => { dragging = false; });
      el.addEventListener('pointercancel', () => { dragging = false; });
      el.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') { set(pos - 2); e.preventDefault(); }
        else if (e.key === 'ArrowRight') { set(pos + 2); e.preventDefault(); }
        else if (e.key === 'Home') { set(0); e.preventDefault(); }
        else if (e.key === 'End') { set(100); e.preventDefault(); }
      });
      set(pos);
    });

    // ===== Touch devices: swap each service card to its hover photo while it sits in view =====
    (function () {
      if (!window.matchMedia('(hover: none)').matches) return;
      const cards = document.querySelectorAll('.card');
      if (!cards.length || !('IntersectionObserver' in window)) return;
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => e.target.classList.toggle('is-inview', e.isIntersecting));
      }, { rootMargin: '-30% 0px -30% 0px' });
      cards.forEach((c) => io.observe(c));
    })();
  </script>
</BaseLayout>
