  <!-- ===================== BLOG / ADVICE =====================
       The three newest posts. Cards use the shared .bl-* styles in
       global.css so this list and /blog stay identical. -->
  <section id="advice" class="bg-white" data-nav-theme="light">
    <div class="bl-sec mx-auto max-w-[1920px] px-5 sm:px-10 lg:px-[60px] pb-20 lg:pb-[110px]">

      <div class="bl-head flex flex-wrap items-center justify-between gap-6">
        <h2 class="font-bold capitalize text-ink leading-[1.02] tracking-[-0.03em] text-[clamp(2.1rem,5vw,4rem)]">
          Remodeling advice &amp; insights
        </h2>
        <a href="/blog" class="btn bl-more">See more blogs</a>
      </div>

      <div class="bl-rail bl-list mt-12 lg:mt-16 sm:grid sm:gap-x-10 sm:gap-y-12 min-[860px]:grid-cols-2 xl:grid-cols-3">
        {latestPosts.map((post) => <PostCard post={post} headingLevel="h3" />)}
      </div>
    </div>
  </section>

  <script is:inline>
    // Shared reduced-motion flag used by the hero rotator, count-up, parallax,
    // and reviews carousel below.
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Hero service rotator — cycles the brand-colored line through our core services.
    // Starts on the visitor's first interaction (not on load): every swap repaints
    // the biggest text on screen, and swaps BEFORE any input keep pushing the
    // page's LCP later — Lighthouse/CrUX read the last swap, not the real load.
    // Interaction ends LCP observation, so rotating after it is free; a fallback
    // timer still starts the show for completely motionless visitors.
    const rotator = document.getElementById('heroRotator');
    if (rotator) {
      const services = ['Custom Showers', 'Tile &amp; Natural Stone', 'Flooring'];
      let si = 0;
      let started = false;
      const startRotator = () => {
        if (started) return;
        started = true;
        setInterval(() => {
          si = (si + 1) % services.length;
          if (reduceMotion) { rotator.innerHTML = services[si]; return; }
          rotator.classList.add('is-out');
          setTimeout(() => {
            rotator.innerHTML = services[si];
            rotator.classList.remove('is-out');
          }, 350);
        }, 3000);
      };
      ['pointerdown', 'pointermove', 'wheel', 'touchstart', 'keydown', 'scroll'].forEach((ev) =>
        window.addEventListener(ev, startRotator, { once: true, passive: true })
      );
      setTimeout(startRotator, 12000);
    }

    // Count-up animation for stats (runs when each number scrolls into view)
    const nums = document.querySelectorAll('.stat-num');
    const fmt = (val, dec) => dec ? val.toFixed(dec) : String(Math.round(val));
    const runCount = (el) => {
      const target = parseFloat(el.dataset.count);
      const dec = (el.dataset.count.split('.')[1] || '').length;
      const duration = 1500;
      let startTime = null;
      const tick = (now) => {
        if (startTime === null) startTime = now;
        const p = Math.min((now - startTime) / duration, 1);
        const eased = 1 - Math.pow(1 - p, 3); // easeOutCubic
        el.textContent = fmt(target * eased, dec);
        if (p < 1) requestAnimationFrame(tick);
        else el.textContent = fmt(target, dec);
      };
      requestAnimationFrame(tick);
    };

    if (reduceMotion || !('IntersectionObserver' in window)) {
      nums.forEach((el) => { el.textContent = fmt(parseFloat(el.dataset.count), (el.dataset.count.split('.')[1] || '').length); });
    } else {
      nums.forEach((el) => { el.textContent = fmt(0, (el.dataset.count.split('.')[1] || '').length); });
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { runCount(e.target); io.unobserve(e.target); }
        });
      }, { threshold: 0.6 });
      nums.forEach((el) => io.observe(el));
    }

    // Vertical auto-scrolling photo wall (home-page build: swaps columns 1 and 3)
    const wall = document.getElementById('galleryWall');
    if (wall) {
      // Real job photos, Aug 2026 client sets — the three service galleries
      // (flooring / custom showers / tile & natural stone) interleaved so no
      // column of the wall reads as one single trade.
      // TODO(client): the `city` on each photo is a placeholder spread across the
      // service area — confirm the real job city for each shot before launch.
      const photos = [
        { src: '/assets/images/gallery-flooring/flooring-1.webp', city: 'Bradenton' },
        { src: '/assets/images/gallery-showers-2026/showers-1.webp', city: 'Sarasota' },
        { src: '/assets/images/gallery-tile-2026/tile-1.webp', city: 'Lakewood Ranch' },
        { src: '/assets/images/gallery-flooring/flooring-2.webp', city: 'Palmetto' },
        { src: '/assets/images/gallery-showers-2026/showers-2.webp', city: 'Venice' },
        { src: '/assets/images/gallery-tile-2026/tile-2.webp', city: 'Parrish' },
        { src: '/assets/images/gallery-flooring/flooring-3.webp', city: 'Siesta Key' },
        { src: '/assets/images/gallery-showers-2026/showers-3.webp', city: 'Ellenton' },
        { src: '/assets/images/gallery-tile-2026/tile-3.webp', city: 'Longboat Key' },
        { src: '/assets/images/gallery-flooring/flooring-4.webp', city: 'University Park' },
        { src: '/assets/images/gallery-showers-2026/showers-4.webp', city: 'Nokomis' },
        { src: '/assets/images/gallery-tile-2026/tile-4.webp', city: 'Anna Maria' },
        { src: '/assets/images/gallery-flooring/flooring-5.webp', city: 'Holmes Beach' },
        { src: '/assets/images/gallery-showers-2026/showers-5.webp', city: 'Bradenton Beach' },
        { src: '/assets/images/gallery-tile-2026/tile-5.webp', city: 'Bradenton' },
        { src: '/assets/images/gallery-flooring/flooring-6.webp', city: 'Sarasota' },
        { src: '/assets/images/gallery-showers-2026/showers-6.webp', city: 'Lakewood Ranch' },
        { src: '/assets/images/gallery-tile-2026/tile-6.webp', city: 'Palmetto' },
        { src: '/assets/images/gallery-flooring/flooring-7.webp', city: 'Venice' },
        { src: '/assets/images/gallery-showers-2026/showers-7.webp', city: 'Parrish' },
        { src: '/assets/images/gallery-flooring/flooring-8.webp', city: 'Siesta Key' },
        { src: '/assets/images/gallery-showers-2026/showers-8.webp', city: 'Ellenton' },
        { src: '/assets/images/gallery-flooring/flooring-9.webp', city: 'Longboat Key' },
        { src: '/assets/images/gallery-showers-2026/showers-9.webp', city: 'University Park' },
        { src: '/assets/images/gallery-flooring/flooring-10.webp', city: 'Nokomis' },
        { src: '/assets/images/gallery-showers-2026/showers-10.webp', city: 'Anna Maria' },
        { src: '/assets/images/gallery-showers-2026/showers-11.webp', city: 'Holmes Beach' },
        { src: '/assets/images/gallery-showers-2026/showers-12.webp', city: 'Bradenton Beach' },
      ];
      const durations = [40, 32, 46, 36, 42];
      const colsFor = (w) => (w >= 1024 ? 5 : w >= 640 ? 3 : 2);
      let built = 0;
      const cell = (p) =>
        `<div class="vcell relative overflow-hidden aspect-[4/5]"><img src="${p.src}" alt="VL Pro Construction project in ${p.city}, FL" loading="lazy" class="gallery-img w-full h-full object-cover"/><span class="vloc">${p.city}, FL</span></div>`;
      const build = () => {
        const n = colsFor(window.innerWidth);
        if (n === built && wall.childElementCount) return;
        built = n;
        const cols = Array.from({ length: n }, () => []);
        const total = Math.max(photos.length, n * 3);
        for (let i = 0; i < total; i++) cols[i % n].push(photos[i % photos.length]);
        // Home-page-only swap: column 1 and column 3 photos so the wall opens on a different mix.
        if (n >= 3) { const swap = cols[0]; cols[0] = cols[2]; cols[2] = swap; }
        wall.innerHTML = cols
          .map((imgs, ci) => {
            const set = imgs.map(cell).join('');
            const dir = ci % 2 ? ' vcol-down' : '';
            const dur = durations[ci % durations.length];
            return `<div class="vcol${dir}" style="animation-duration:${dur}s">${set}${set}</div>`;
          })
          .join('');
      };
      // Build only when the wall approaches the viewport — building at page
      // load makes the browser fetch every wall photo immediately (dozens of
      // requests, several MB), starving the above-fold content on mobile.
      // `loading="lazy"` doesn't save us here: mobile lazy thresholds are
      // thousands of px, and the cells sit inside animated columns.
      let wallReady = false;
      const buildOnce = () => {
        if (wallReady) return;
        wallReady = true;
        build();
        let resizeT;
        window.addEventListener('resize', () => { clearTimeout(resizeT); resizeT = setTimeout(build, 200); }, { passive: true });
      };
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            if (entries.some((e) => e.isIntersecting)) {
              io.disconnect();
              buildOnce();
            }
          },
          { rootMargin: '1200px 0px' }
        );
        io.observe(wall);
      } else {
        buildOnce();
      }
    }

    // Parallax process photos — each image drifts within its frame as the section scrolls
    const pxImgs = [...document.querySelectorAll('.px-img:not(.px-fit)')];
    if (pxImgs.length && !reduceMotion) {
      let ticking = false;
      const renderParallax = () => {
        const vh = window.innerHeight;
        pxImgs.forEach((img) => {
          const frame = img.parentElement;
          const r = frame.getBoundingClientRect();
          if (r.bottom < 0 || r.top > vh) return;
          const progress = (r.top + r.height / 2 - vh / 2) / (vh / 2 + r.height / 2);
          const shift = frame.offsetHeight * 0.20;
          img.style.transform = `translateY(${(progress * shift).toFixed(1)}px)`;
        });
        ticking = false;
      };
      const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(renderParallax); } };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      renderParallax();
    }


    // Partner logo marquee — varied wordmark styling reads as a row of logos
    const logoTrack = document.getElementById('logoTrack');
    if (logoTrack) {
      // TODO: real partner / supplier logos (swap wordmarks for <img> when available)
      const brands = [
        { name: 'SCHLUTER', cls: 'font-bold tracking-[0.04em]' },
        { name: 'DALTILE', cls: 'font-serifd font-semibold tracking-[0.12em]' },
        { name: 'KOHLER', cls: 'font-semibold tracking-[0.32em]' },
        { name: 'MOEN', cls: 'font-bold tracking-[0.06em]' },
        { name: 'MARAZZI', cls: 'font-serifd tracking-[0.05em]' },
        { name: 'MOHAWK', cls: 'font-bold tracking-[0.18em]' },
        { name: 'MSI', cls: 'font-bold tracking-[0.2em]' },
        { name: 'BOSTIK', cls: 'font-semibold tracking-[0.14em]' },
      ];
      const span = (b) =>
        `<span class="logo-item ${b.cls} text-[clamp(1.05rem,1.7vw,1.65rem)]">${b.name}</span>`;
      const set = brands.map(span).join('');
      logoTrack.innerHTML = set + set;
    }

    // FAQ accordion — single-open; content stays visible if JS is unavailable
    const faqList = document.getElementById('faqList');
    if (faqList) {
      faqList.classList.add('js-faq');
      const items = [...faqList.querySelectorAll('.faq-item')].map((item) => ({
        q: item.querySelector('.faq-q'),
        a: item.querySelector('.faq-a'),
      }));
      const collapse = (it) => { it.q.setAttribute('aria-expanded', 'false'); it.a.style.height = '0px'; };
      const expand = (it) => { it.q.setAttribute('aria-expanded', 'true'); it.a.style.height = it.a.scrollHeight + 'px'; };
      items.forEach((it) => {
        collapse(it);
        it.q.addEventListener('click', () => {
          const isOpen = it.q.getAttribute('aria-expanded') === 'true';
          items.forEach(collapse);
          if (!isOpen) expand(it);
        });
      });
      window.addEventListener('resize', () => {
        const open = items.find((it) => it.q.getAttribute('aria-expanded') === 'true');
        if (open) open.a.style.height = open.a.scrollHeight + 'px';
      }, { passive: true });
    }

    // Before / After slider — press anywhere and drag; the divider follows the pointer
    document.querySelectorAll('.ba').forEach((el) => {
      let pos = 50;
      let dragging = false;
      const set = (pct) => {
        pos = Math.max(0, Math.min(100, pct));
        el.style.setProperty('--pos', pos + '%');
        el.setAttribute('aria-valuenow', Math.round(pos));
      };
      const setFromX = (clientX) => {
        const r = el.getBoundingClientRect();
        set(((clientX - r.left) / r.width) * 100);
      };
      el.addEventListener('pointerdown', (e) => {
        dragging = true; setFromX(e.clientX); el.setPointerCapture(e.pointerId); e.preventDefault();
      });
      el.addEventListener('pointermove', (e) => { if (dragging) setFromX(e.clientX); });
      el.addEventListener('pointerup', () => { dragging = false; });
      el.addEventListener('pointercancel', () => { dragging = false; });
      el.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') { set(pos - 2); e.preventDefault(); }
        else if (e.key === 'ArrowRight') { set(pos + 2); e.preventDefault(); }
        else if (e.key === 'Home') { set(0); e.preventDefault(); }
        else if (e.key === 'End') { set(100); e.preventDefault(); }
      });
      set(pos);
    });

    // ===== Touch devices: swap each service card to its hover photo while it sits in view =====
    (function () {
      if (!window.matchMedia('(hover: none)').matches) return;
      const cards = document.querySelectorAll('.card');
      if (!cards.length || !('IntersectionObserver' in window)) return;
      // Hold the swap for a beat after the card lands, so the photo doesn't
      // flip while the card is still sliding up into the middle band.
      const timers = new WeakMap();
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          clearTimeout(timers.get(e.target));
          if (e.isIntersecting) {
            timers.set(e.target, setTimeout(() => e.target.classList.add('is-inview'), 550));
          } else {
            e.target.classList.remove('is-inview');
          }
        });
      }, { rootMargin: '-30% 0px -30% 0px' });
      cards.forEach((c) => io.observe(c));
    })();
  </script>

  <!-- Exit-intent offer popup (home page only) -->
</BaseLayout>
