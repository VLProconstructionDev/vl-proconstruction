---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@components/PostCard.astro';
import { sortPosts, visible } from '@/lib/blog';
import ServiceAreaMap from '@components/ServiceAreaMap.astro';
import EstimateInline from '@components/EstimateInline.astro';
import { websiteSchema, faqSchema } from '@/lib/schema';

// Home-page "Advice & insights" teaser — the three newest posts, same cards
// as the /blog index (.bl-* in global.css).
const latestPosts = sortPosts(await getCollection('blog', visible)).slice(0, 3);

// Single source for the #faqs accordion AND the FAQPage JSON-LD — Google
// requires the marked-up Q&As to be the ones visible on the page, so both
// render from this array and cannot drift apart. `list` renders as bullets;
// `a` is then the plain-text equivalent the schema needs.
const faqs: { q: string; a: string; list?: string[] }[] = [
  {
    q: 'How much does a bathroom remodel cost?',
    a: 'Every project is different depending on the size, materials, and scope of work. We provide a free on-site consultation and a written estimate before work begins.',
  },
  {
    q: 'How long does a bathroom renovation take?',
    a: 'Most bathroom remodels take 2–4 weeks depending on demolition, plumbing changes, tile installation, custom showers, and material availability.',
  },
  {
    q: 'Do you offer free estimates?',
    a: 'Yes. We offer free in-home consultations where we discuss your ideas, take measurements, and provide a detailed estimate.',
  },
  {
    q: 'Are you licensed and insured?',
    a: 'Yes. VL Proconstruction LLC is licensed and insured in Florida.',
  },
  {
    q: 'Can I stay in my home during the remodel?',
    a: 'In most cases, yes. We work to minimize dust and disruption and keep the job site clean throughout the project.',
  },
  {
    q: 'Do you provide a warranty?',
    a: 'Yes. We stand behind our workmanship and use quality installation methods and premium materials designed for long-term performance.',
  },
  {
    q: 'Why should I choose VL Proconstruction?',
    a: 'Over 22 years of experience, Schluter-certified waterproofing, attention to detail, professional communication, clean job sites, transparent pricing, and high-quality craftsmanship.',
    list: [
      'Over 22 years of experience',
      'Schluter-certified waterproofing',
      'Attention to detail',
      'Professional communication',
      'Clean job sites',
      'Transparent pricing',
      'High-quality craftsmanship',
    ],
  },
  {
    q: 'Do you help with tile selection and design?',
    a: 'Yes. We can help you choose tile, grout color, layouts, trim, and finishes that match your style and budget.',
  },
];

const schema = [websiteSchema(), faqSchema(faqs)];
---

<BaseLayout
  title="VL Proconstruction — Bradenton Sarasota Construction Experts"
  description="Professional tile installation, flooring, custom showers, bathroom upgrades, demolition, and subfloor prep for homeowners and businesses in the Bradenton area."
  schema={schema}
  navTheme="dark"
>
  <style is:global>
    /* body font override — hero + sections rely on Inter; overflow-x rule lives in global.css */
    body { font-family: 'Inter', system-ui, sans-serif; }

    .card-img { transition: transform .6s cubic-bezier(.2,.8,.2,1); }
    .card:hover .card-img { transform: scale(1.04); }
    /* ----- Consultation chips ----- */
    .consult-chip { display: flex; align-items: center; gap: 12px; padding: 6px 0;
      font-size: 15px; font-weight: 600; letter-spacing: -.02em; color: #1e1e1e; }
    .consult-check { display: grid; place-items: center; flex: none; width: 22px; height: 22px; border-radius: 9999px;
      background: transparent; color: #1e1e1e; }
    .consult-check svg { width: 19px; height: 19px; }
    /* Photo fades into the card surface on its inner edge */
    .consult-photo { -webkit-mask-image: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,.5) 14%, #000 30%); mask-image: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,.5) 14%, #000 30%); }
    @media (min-width: 1024px) {
      .consult-photo { -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,.5) 16%, #000 34%); mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,.5) 16%, #000 34%); } }
    /* phones: tighter rows so the card doesn't dominate the scroll */
    @media (max-width: 639px) {
      .consult-chip { padding: 2px 0; gap: 10px; }
      .consult-photo { -webkit-mask-image: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,.5) 10%, #000 22%); mask-image: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,.5) 10%, #000 22%); } }
    @media (prefers-reduced-motion: reduce) { .consult-chip { transition: none; } }
    .card-img-hover { opacity: 0; transition: opacity .5s ease, transform .6s cubic-bezier(.2,.8,.2,1); }
    .card:hover .card-img-hover { opacity: 1; transform: scale(1.04); }
    /* Touch devices have no hover — the second photo reveals as the card scrolls into view */
    @media (hover: none) {
      .card.is-inview .card-img-hover { opacity: 1; transform: scale(1.04); }
      .card.is-inview .card-arrow { transform: translate(3px,-3px); } }
    @media (prefers-reduced-motion: reduce) { .card-img-hover { transition: opacity .3s ease; } }
    .card:hover .card-arrow { transform: translate(3px,-3px); }
    .card-arrow { transition: transform .25s ease; }
    .rev { transition: transform .25s cubic-bezier(.2,.8,.2,1), border-color .25s, background-color .25s; }
    .rev:hover { transform: translateY(-4px); border-color: rgba(245,75,37,.4); }
    .trust-pill { transition: border-color .2s, background-color .2s; }
    .trust-pill:hover { border-color: rgba(245,75,37,.5); background-color: rgba(0,0,0,.03); }
    @media (prefers-reduced-motion: reduce) { .btn, .card-img, .card-arrow, .rev { transition: none; transform: none; } }

    /* Hero service rotator — words fade/lift in and out */
    .rotator-word { display: inline-block; transition: opacity .35s ease, transform .35s cubic-bezier(.22,1,.36,1); }
    .rotator-word.is-out { opacity: 0; transform: translateY(0.18em); }
    @media (prefers-reduced-motion: reduce) { .rotator-word { transition: none; } .rotator-word.is-out { opacity: 1; transform: none; } }

    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .gallery-img { transition: transform .6s cubic-bezier(.2,.8,.2,1); }
    .gallery-img:hover { transform: scale(1.05); }
    @media (prefers-reduced-motion: reduce) { .gallery-img { transition: none; transform: none; } }

    /* ----- Vertical auto-scrolling photo wall ----- */
    .vwall { position: relative; overflow: hidden; height: clamp(960px, 138vh, 1560px); }
    #galleryWall { display: flex; gap: 8px; height: 100%; }
    .vcol { flex: 1 1 0; min-width: 0; will-change: transform; animation: vUp linear infinite; }
    .vcol-down { animation-name: vDown; }
    .vcell { margin-bottom: 8px; }
    @keyframes vUp   { from { transform: translateY(0); }    to { transform: translateY(-50%); } }
    @keyframes vDown { from { transform: translateY(-50%); } to { transform: translateY(0); } }
    /* soft fade so photos emerge/exit instead of hard-cropping */
    .vwall::before, .vwall::after { content: ""; position: absolute; left: 0; right: 0; pointer-events: none; z-index: 2; }
    .vwall::before { top: 0;    height: 96px;  background: linear-gradient(to bottom, #000, rgba(0,0,0,0)); }
    .vwall::after  { bottom: 0; height: 280px; background: linear-gradient(to top, #000 0%, rgba(0,0,0,0.92) 18%, rgba(0,0,0,0.72) 38%, rgba(0,0,0,0.45) 58%, rgba(0,0,0,0.2) 78%, rgba(0,0,0,0) 100%); }
    @media (prefers-reduced-motion: reduce) {
      .vwall { height: auto; overflow: visible; }
      .vcol { animation: none; }
      .vwall::before, .vwall::after { display: none; }
    }

    /* ----- Parallax process photos ----- */
    .px-frame { position: relative; overflow: hidden; }
    /* let grid tracks shrink so a fixed-width process image can't push past the viewport (tablet) */
    .process-step > * { min-width: 0; }
    .px-frame .px-img { position: absolute; left: 0; top: -20%; width: 100%; height: 140%; object-fit: cover; will-change: transform; }
    @media (prefers-reduced-motion: reduce) {
      .px-frame .px-img { position: static; top: 0; height: 100%; transform: none; }
    }

    /* ----- FAQ accordion ----- */
    .faq-item { border-bottom: 1px solid rgba(0,0,0,.1); }
    .faq-item:first-child { border-top: 1px solid rgba(0,0,0,.1); }
    .faq-q { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 28px; text-align: left; padding: 26px 0; cursor: pointer; color: #1e1e1e; }
    .faq-ico { position: relative; flex: none; width: 24px; height: 24px; }
    .faq-ico::before, .faq-ico::after { content: ""; position: absolute; background: #1e1e1e; transition: transform .3s ease, opacity .3s ease; }
    .faq-ico::before { top: 50%; left: 0; right: 0; height: 2px; transform: translateY(-50%); }
    .faq-ico::after { left: 50%; top: 0; bottom: 0; width: 2px; transform: translateX(-50%); }
    .faq-q[aria-expanded="true"] .faq-ico::after { transform: translateX(-50%) scaleY(0); opacity: 0; }
    .faq-q[aria-expanded="true"] .faq-ico::before { background: #f54b25; }
    .faq-a { overflow: hidden; }
    .faq-a-inner { padding-bottom: 26px; }
    .js-faq .faq-a { transition: height .32s cubic-bezier(.4,0,.2,1); }
    @media (prefers-reduced-motion: reduce) { .js-faq .faq-a { transition: none; } }

    /* ----- Partner logo marquee ----- */
    .logo-marquee { position: relative; overflow: hidden; }
    .logo-track { display: flex; align-items: center; width: max-content; animation: logoScroll 34s linear infinite; }
    .logo-item { margin-right: clamp(44px, 6vw, 96px); white-space: nowrap; color: #a6a6a6; transition: color .25s; }
    .logo-marquee:hover .logo-track { animation-play-state: paused; }
    .logo-item:hover { color: #1e1e1e; }
    @keyframes logoScroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
    .logo-marquee::before, .logo-marquee::after { content: ""; position: absolute; top: 0; bottom: 0; width: clamp(48px, 8vw, 120px); z-index: 2; pointer-events: none; }
    .logo-marquee::before { left: 0;  background: linear-gradient(to right, #f6f5f3, rgba(246,245,243,0)); }
    .logo-marquee::after  { right: 0; background: linear-gradient(to left,  #f6f5f3, rgba(246,245,243,0)); }
    @media (prefers-reduced-motion: reduce) { .logo-track { animation: none; } }

    /* ----- Reviews quote slide ----- */
    .rev-fade { transition: opacity .35s ease, transform .45s cubic-bezier(.22,1,.36,1); will-change: transform, opacity; }
    @media (prefers-reduced-motion: reduce) { .rev-fade { transition: none !important; transform: none !important; } }
    /* ----- Reviews pagination dots ----- */
    .rev-dot { flex: none; height: 6px; width: 6px; border-radius: 9999px; background: rgba(30,30,30,.2); transition: transform .3s cubic-bezier(.2,.8,.2,1), background-color .25s ease; }
    .rev-dot:hover { background: rgba(30,30,30,.38); }
    .rev-dot:focus-visible { outline: 2px solid #f54b25; outline-offset: 3px; }
    .rev-dot.is-active { background: #f54b25; transform: scale(1.35); }
    @media (prefers-reduced-motion: reduce) { .rev-dot { transition: none; } }

    /* ----- Process steps stick & overlap one another as you scroll ----- */
    .process-step { position: sticky; background: #faf9f8; }
    .process-step:nth-child(1) { top: 92px; }
    .process-step:nth-child(2) { top: 124px; }
    .process-step:nth-child(3) { top: 156px; }
    @media (prefers-reduced-motion: reduce) {
      .process-step { position: static; box-shadow: none; }
    }

    /* ---- Service-area map ---- */
    /* edge fade into the black section — matches the consultation photo treatment */
    .area-map-fade { -webkit-mask-image: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,.12) 3%, rgba(0,0,0,.45) 6%, rgba(0,0,0,.8) 10%, #000 14%); mask-image: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,.12) 3%, rgba(0,0,0,.45) 6%, rgba(0,0,0,.8) 10%, #000 14%); }
    @media (min-width: 1024px) {
      .area-map-fade { -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,.12) 3%, rgba(0,0,0,.45) 7%, rgba(0,0,0,.8) 11%, #000 15%); mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,.12) 3%, rgba(0,0,0,.45) 7%, rgba(0,0,0,.8) 11%, #000 15%); }
    }
    /* Soft frosted blur along the fade edge, strongest at the edge and easing gradually to none */
    .area-map-fade::before { content: ''; position: absolute; inset: 0; z-index: 450; pointer-events: none;
      -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px);
      -webkit-mask-image: linear-gradient(to bottom, #000 0%, rgba(0,0,0,.55) 4%, rgba(0,0,0,.2) 8%, transparent 11%);
      mask-image: linear-gradient(to bottom, #000 0%, rgba(0,0,0,.55) 4%, rgba(0,0,0,.2) 8%, transparent 11%); }
    @media (min-width: 1024px) {
      .area-map-fade::before { -webkit-mask-image: linear-gradient(to right, #000 0%, rgba(0,0,0,.55) 4%, rgba(0,0,0,.2) 9%, transparent 12%);
        mask-image: linear-gradient(to right, #000 0%, rgba(0,0,0,.55) 4%, rgba(0,0,0,.2) 9%, transparent 12%); }
    }
    /* Service-area map — glowing 45-mile radius + text labels (no pins) */
    .svc-radius { filter: drop-shadow(0 0 5px rgba(245,75,37,.85)) drop-shadow(0 0 13px rgba(245,75,37,.45)); }
    .svc-dot { width: 9px; height: 9px; border-radius: 9999px; background: #f54b25;
      box-shadow: 0 0 6px rgba(245,75,37,.95), 0 0 12px rgba(245,75,37,.5); }
    .leaflet-tooltip.svc-tt { background: transparent; border: none; box-shadow: none; padding: 0;
      color: #fff; font-family: 'Poppins', sans-serif; font-weight: 600; white-space: nowrap;
      text-shadow: 0 1px 4px rgba(0,0,0,.9), 0 0 2px rgba(0,0,0,.6); }
    .leaflet-tooltip.svc-tt::before { display: none; }
    .leaflet-tooltip.svc-tt.lg { font-size: clamp(17px, 1.8vw, 26px); font-weight: 500; letter-spacing: .06em; text-transform: uppercase; color: #7c7c7c; }
    .leaflet-tooltip.svc-tt.md { font-size: 15px; font-weight: 500; letter-spacing: .04em; text-transform: uppercase; opacity: .8; }
    .leaflet-tooltip.svc-tt.key { font-size: 12.5px; color: #f0f0f0; }
    .leaflet-tooltip.svc-tt.county { font-size: 12px; letter-spacing: .16em; text-transform: uppercase;
      color: #d98166; opacity: .8; font-weight: 600; }
    /* Coastal keys — label + dashed leader line + dot, anchored at the real location */
    .leaflet-div-icon { background: transparent; border: none; }
    .svc-conn-inner { position: absolute; right: 0; top: 0; transform: translateY(-50%);
      display: flex; align-items: center; white-space: nowrap; pointer-events: none; }
    .svc-conn-label { font-family: 'Poppins', sans-serif; font-weight: 600; font-size: 12.5px; color: #f0f0f0;
      text-shadow: 0 1px 4px rgba(0,0,0,.9), 0 0 2px rgba(0,0,0,.6); }
    .svc-conn-line { width: 32px; height: 0; border-top: 1.5px dashed rgba(245,75,37,.85); margin: 0 8px; }
    /* Inline red dot shown before town / county labels */
    .svc-tt-dot { display: inline-block; width: 8px; height: 8px; border-radius: 9999px; background: #f54b25;
      margin-left: 7px; vertical-align: middle; position: relative; top: -1px;
      box-shadow: 0 0 5px rgba(245,75,37,.9), 0 0 10px rgba(245,75,37,.45); }
    /* ---- Service-area map (Leaflet) ---- */
    #areaMap { height: 100%; width: 100%; background: #000; z-index: 0; }
    #areaMap .leaflet-tile-pane { filter: saturate(0.85); } /* keep the dark basemap deep black */
    /* hide attribution prefix flag, keep credits subtle */
    #areaMap .leaflet-control-attribution { background: rgba(0,0,0,.55); color: rgba(255,255,255,.4); }
    #areaMap .leaflet-control-attribution a { color: rgba(255,255,255,.6); }
    /* zoom controls themed to match the dark/brand UI */
    #areaMap .leaflet-bar a {
      background: rgba(20,20,20,.92); color: #fff; border-bottom-color: rgba(255,255,255,.12);
      transition: background-color .18s ease, color .18s ease;
    }
    #areaMap .leaflet-bar a:hover { background: #f54b25; color: #fff; }
    #areaMap .leaflet-bar { border: 1px solid rgba(255,255,255,.14); box-shadow: 0 8px 24px rgba(0,0,0,.5); }
    /* custom red teardrop pin */
    .area-pin { filter: drop-shadow(0 4px 6px rgba(0,0,0,.5)); }
    .area-pin svg { display: block; transition: transform .2s cubic-bezier(.2,.8,.2,1); transform-origin: 50% 100%; }
    .leaflet-marker-icon.area-pin:hover svg { transform: scale(1.14); }
    /* popup styling */
    #areaMap .leaflet-popup-content-wrapper {
      background: #141414; color: #fff; border: 1px solid rgba(255,255,255,.12);
      border-radius: 12px; box-shadow: 0 12px 32px rgba(0,0,0,.55);
    }
    #areaMap .leaflet-popup-content { margin: 10px 14px; font-size: 14px; font-weight: 600; letter-spacing: -0.01em; }
    #areaMap .leaflet-popup-tip { background: #141414; border: 1px solid rgba(255,255,255,.12); }
    #areaMap .leaflet-popup-close-button { color: rgba(255,255,255,.5); }
    #areaMap a.leaflet-popup-close-button:hover { color: #fff; }

    /* ----- Before / After comparison slider ----- */
    .ba { position: relative; overflow: hidden; background: #111;
      aspect-ratio: 4 / 3; touch-action: pan-y; cursor: ew-resize; user-select: none; }
    @media (min-width: 1024px) { .ba { aspect-ratio: 5 / 3; } }
    .ba:focus { outline: none; }
    .ba:focus-visible .ba-handle { outline: 3px solid #f54b25; outline-offset: 3px; }
    /* both photos are the exact same full-size box in the exact same position;
       only a clip reveals the BEFORE up to the divider, so nothing ever resizes */
    .ba-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
      object-position: center; -webkit-user-drag: none; user-select: none; }
    .ba-before { clip-path: inset(0 calc(100% - var(--pos, 50%)) 0 0); z-index: 2; }
    .ba-line { position: absolute; top: 0; bottom: 0; left: var(--pos, 50%); z-index: 5; width: 2px;
      background: #fff; transform: translateX(-1px); pointer-events: none;
      box-shadow: 0 0 0 1px rgba(0,0,0,.05), 0 0 18px rgba(0,0,0,.28); }
    .ba-handle { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
      width: 54px; height: 54px; border-radius: 0; background: #fff; color: #1e1e1e;
      display: grid; place-items: center; box-shadow: 0 6px 20px rgba(0,0,0,.3), 0 2px 6px rgba(0,0,0,.2); }
    .ba-handle svg { width: 22px; height: 22px; }
  </style>

  <!-- ===================== HERO ===================== -->
  <section id="hero" class="relative min-h-screen lg:h-screen overflow-hidden text-white bg-black">
    <!-- Fullscreen background video -->
    <video class="absolute inset-0 w-full h-full object-cover" muted loop playsinline preload="none" data-webm="/assets/video/hero-0715.webm" data-mp4="/assets/video/hero-0715.mp4" poster="/assets/images/hero-poster-0715.webp" aria-hidden="true" tabindex="-1">
    </video>
    <div class="absolute inset-0 bg-black/65"></div>

    <!-- Hero content -->
    <div class="relative z-20 h-full mx-auto max-w-[1920px] px-5 sm:px-10 lg:px-[60px] flex flex-col justify-end pb-9 sm:pb-12 lg:pb-[62px] pt-[150px] gap-8 lg:gap-10">
      <!-- Trust row -->
      <div class="flex items-center gap-3.5 flex-wrap -mb-3 lg:-mb-4">
        <a href="https://maps.app.goo.gl/7Yi5JeKD4vwVWFXo9" target="_blank" rel="noopener noreferrer" aria-label="View our Google reviews" class="inline-block rounded-md transition-transform duration-200 ease-out hover:scale-[1.14] active:scale-[1.02] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70 focus-visible:ring-offset-2 focus-visible:ring-offset-transparent">
          <img src="/assets/images/google.webp" alt="Google" class="h-9 w-auto object-contain" />
        </a>
        <img src="/assets/images/bbb.webp" alt="BBB A+ rating" class="h-7 w-auto object-contain" />
        <span class="h-6 w-px bg-white/40"></span>
        <div class="flex items-center gap-1.5">
          <span class="text-[#fbbf24] text-xl tracking-tight">★★★★★</span>
          <span class="text-[15px] font-semibold uppercase">5.0</span>
        </div>
      </div>

      <!-- Heading + description -->
      <div class="font-semibold capitalize leading-[1.03] tracking-[-0.03em] text-[clamp(2.75rem,6.2vw,5.5rem)]">
        <h1>
          <span>Sarasota</span><br />
          <span class="text-brand block min-h-[2.06em] sm:min-h-0"><span id="heroRotator" class="rotator-word">Custom <br class="sm:hidden" />Showers</span></span>
        </h1>
        <div class="flex flex-col sm:flex-row sm:items-end gap-3 sm:gap-8">
          <span>Experts</span>
          <p class="sm:mb-3 text-[14px] font-medium normal-case leading-[1.25] tracking-[-0.02em] text-[#f0f0f0] max-w-[480px]">
            We specialize in custom showers, tile and hard surface flooring installation for homeowners and businesses throughout Sarasota and surrounding areas, delivering a complete start to finish solution backed by skilled craftsmanship, professional service, and trusted local expertise.
          </p>
        </div>
      </div>

      <!-- Buttons + stats -->
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8">
        <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-3 sm:gap-4 w-full sm:w-auto">
          <a href="#estimate" class="btn js-open-estimate w-full sm:w-auto text-center bg-brand hover:bg-[#c23c18] rounded-full px-8 py-3.5 text-[18px] font-semibold capitalize text-white">Get a Free estimate</a>
          <a href="tel:+15037814657" class="btn w-full sm:w-auto text-center border border-[#a3a3a3] hover:border-white hover:bg-white/10 rounded-full px-8 py-3.5 text-[18px] font-semibold capitalize text-[#f2f2f2]">call now</a>
        </div>

        <div class="grid grid-cols-3 gap-x-3 sm:gap-x-8 gap-y-5 lg:flex lg:flex-wrap lg:justify-end">
          <div class="flex flex-col items-start lg:items-end">
            <span class="font-normal text-[1.9rem] sm:text-[clamp(2.55rem,4.2vw,3.8rem)] leading-[1.085] tracking-[-0.04em]"><span class="stat-num" data-count="22">22</span>+</span>
            <span class="font-poppins text-[11px] sm:text-[16.5px] font-medium capitalize text-[#e9e9e9] tracking-[-0.03em] leading-[1.25]">Years of <br class="sm:hidden" />excellence</span>
          </div>
          <div class="flex flex-col items-start lg:items-end">
