---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ServiceAreaMap from '@components/ServiceAreaMap.astro';
import { breadcrumbSchema, itemListSchema } from '@/lib/schema';
import TrustPill from '@components/TrustPill.astro';

// The three cards below, as structured data — order matches the page.
const schema = [
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Services', url: '/services' },
  ]),
  itemListSchema({
    name: 'VL Proconstruction services',
    items: [
      { name: 'Custom Shower Installation', url: '/services/custom-showers' },
      { name: 'Tile & Natural Stone Installation', url: '/services/tile-natural-stone' },
      { name: 'Hard-Surface Flooring Installation', url: '/services/flooring' },
    ],
  }),
];
---

<BaseLayout
  title="Services — VL Proconstruction | Showers, Tile & Flooring"
  description="Custom showers, tile & natural stone, and hard surface flooring in Bradenton & Sarasota, FL. Call for a free quote: (503) 781-4657"
  schema={schema}
  navTheme="dark"
>
  <style is:global>
    /* ---- Page-specific styles from legacy services/index.html ---- */

    /* Card hover image swap + arrow micro-motion (used in the three service cards) */
    .card-img { transition: transform .6s cubic-bezier(.2,.8,.2,1); }
    .card:hover .card-img { transform: scale(1.04); }
    .card-img-hover { opacity: 0; transition: opacity .5s ease, transform .6s cubic-bezier(.2,.8,.2,1); }
    .card:hover .card-img-hover { opacity: 1; transform: scale(1.04); }
    /* Touch devices have no hover — the second photo reveals as the card scrolls into view */
    @media (hover: none) {
      .card.is-inview .card-img-hover { opacity: 1; transform: scale(1.04); }
      .card.is-inview .card-arrow { transform: translate(3px,-3px); } }
    @media (prefers-reduced-motion: reduce) { .card-img-hover { transition: opacity .3s ease; } }
    .card:hover .card-arrow { transform: translate(3px,-3px); }
    .card-arrow { transition: transform .25s ease; }
    @media (prefers-reduced-motion: reduce) { .card-img, .card-arrow { transition: none; transform: none; } }

    /* Service index chips */
    .svc-chip { transition: border-color .2s, background-color .2s, color .2s, transform .2s cubic-bezier(.22,1,.36,1); }
    .svc-chip:hover { border-color: rgba(245,75,37,.5); background-color: #fff; transform: translateY(-2px); }

    /* Feature checkmark */
    .feat-check { display: grid; place-items: center; flex: none; width: 22px; height: 22px; color: #f54b25; }
    .feat-check svg { width: 19px; height: 19px; }

    /* ---- Service-area map fade (image edge treatment) ---- */
    .area-map-fade { -webkit-mask-image: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,.12) 3%, rgba(0,0,0,.45) 6%, rgba(0,0,0,.8) 10%, #000 14%); mask-image: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,.12) 3%, rgba(0,0,0,.45) 6%, rgba(0,0,0,.8) 10%, #000 14%); }
    @media (min-width: 1024px) {
      .area-map-fade { -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,.12) 3%, rgba(0,0,0,.45) 7%, rgba(0,0,0,.8) 11%, #000 15%); mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,.12) 3%, rgba(0,0,0,.45) 7%, rgba(0,0,0,.8) 11%, #000 15%); }
    }
    .area-map-fade::before { content: ''; position: absolute; inset: 0; z-index: 450; pointer-events: none;
      -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px);
      -webkit-mask-image: linear-gradient(to bottom, #000 0%, rgba(0,0,0,.55) 4%, rgba(0,0,0,.2) 8%, transparent 11%);
      mask-image: linear-gradient(to bottom, #000 0%, rgba(0,0,0,.55) 4%, rgba(0,0,0,.2) 8%, transparent 11%); }
    @media (min-width: 1024px) {
      .area-map-fade::before { -webkit-mask-image: linear-gradient(to right, #000 0%, rgba(0,0,0,.55) 4%, rgba(0,0,0,.2) 9%, transparent 12%);
        mask-image: linear-gradient(to right, #000 0%, rgba(0,0,0,.55) 4%, rgba(0,0,0,.2) 9%, transparent 12%); }
    }

    /* Service-area map — glowing 45-mile radius + text labels (no pins) */
    .svc-radius { filter: drop-shadow(0 0 5px rgba(245,75,37,.85)) drop-shadow(0 0 13px rgba(245,75,37,.45)); }
    .svc-dot { width: 9px; height: 9px; border-radius: 9999px; background: #f54b25;
      box-shadow: 0 0 6px rgba(245,75,37,.95), 0 0 12px rgba(245,75,37,.5); }
    .leaflet-tooltip.svc-tt { background: transparent; border: none; box-shadow: none; padding: 0;
      color: #fff; font-family: 'Poppins', sans-serif; font-weight: 600; white-space: nowrap;
      text-shadow: 0 1px 4px rgba(0,0,0,.9), 0 0 2px rgba(0,0,0,.6); }
    .leaflet-tooltip.svc-tt::before { display: none; }
    .leaflet-tooltip.svc-tt.lg { font-size: clamp(17px, 1.8vw, 26px); font-weight: 500; letter-spacing: .06em; text-transform: uppercase; color: #7c7c7c; }
    .leaflet-tooltip.svc-tt.md { font-size: 15px; font-weight: 500; letter-spacing: .04em; text-transform: uppercase; opacity: .8; }
    .leaflet-tooltip.svc-tt.key { font-size: 12.5px; color: #f0f0f0; }
    .leaflet-tooltip.svc-tt.county { font-size: 12px; letter-spacing: .16em; text-transform: uppercase;
      color: #d98166; opacity: .8; font-weight: 600; }
    .leaflet-div-icon { background: transparent; border: none; }
    .svc-conn-inner { position: absolute; right: 0; top: 0; transform: translateY(-50%);
      display: flex; align-items: center; white-space: nowrap; pointer-events: none; }
    .svc-conn-label { font-family: 'Poppins', sans-serif; font-weight: 600; font-size: 12.5px; color: #f0f0f0;
      text-shadow: 0 1px 4px rgba(0,0,0,.9), 0 0 2px rgba(0,0,0,.6); }
    .svc-conn-line { width: 32px; height: 0; border-top: 1.5px dashed rgba(245,75,37,.85); margin: 0 8px; }
    .svc-tt-dot { display: inline-block; width: 8px; height: 8px; border-radius: 9999px; background: #f54b25;
      margin-left: 7px; vertical-align: middle; position: relative; top: -1px;
      box-shadow: 0 0 5px rgba(245,75,37,.9), 0 0 10px rgba(245,75,37,.45); }

    /* ---- Service-area map (Leaflet) — retained for the archived interactive map ---- */
    #areaMap { height: 100%; width: 100%; background: #000; z-index: 0; }
    #areaMap .leaflet-tile-pane { filter: saturate(0.85); }
    #areaMap .leaflet-control-attribution { background: rgba(0,0,0,.55); color: rgba(255,255,255,.4); }
    #areaMap .leaflet-control-attribution a { color: rgba(255,255,255,.6); }
    #areaMap .leaflet-bar a {
      background: rgba(20,20,20,.92); color: #fff; border-bottom-color: rgba(255,255,255,.12);
      transition: background-color .18s ease, color .18s ease;
    }
    #areaMap .leaflet-bar a:hover { background: #f54b25; color: #fff; }
    #areaMap .leaflet-bar { border: 1px solid rgba(255,255,255,.14); box-shadow: 0 8px 24px rgba(0,0,0,.5); }
    .area-pin { filter: drop-shadow(0 4px 6px rgba(0,0,0,.5)); }
    .area-pin svg { display: block; transition: transform .2s cubic-bezier(.2,.8,.2,1); transform-origin: 50% 100%; }
    .leaflet-marker-icon.area-pin:hover svg { transform: scale(1.14); }
    #areaMap .leaflet-popup-content-wrapper {
      background: #141414; color: #fff; border: 1px solid rgba(255,255,255,.12);
      border-radius: 12px; box-shadow: 0 12px 32px rgba(0,0,0,.55);
    }
    #areaMap .leaflet-popup-content { margin: 10px 14px; font-size: 14px; font-weight: 600; letter-spacing: -0.01em; }
    #areaMap .leaflet-popup-tip { background: #141414; border: 1px solid rgba(255,255,255,.12); }
    #areaMap .leaflet-popup-close-button { color: rgba(255,255,255,.5); }
    #areaMap a.leaflet-popup-close-button:hover { color: #fff; }

    /* Who-we-serve cards accent (kept for parity, though currently hidden) */
    .client-card .card-accent { display: none; }

    /* ----- Parallax process photos (same as the home page) ----- */
    .px-frame { position: relative; overflow: hidden; }
    /* let grid tracks shrink so a fixed-width process image can't push past the viewport (tablet) */
    .process-step > * { min-width: 0; }
    .px-frame .px-img { position: absolute; left: 0; top: -20%; width: 100%; height: 140%; object-fit: cover; will-change: transform; }
    @media (prefers-reduced-motion: reduce) {
      .px-frame .px-img { position: static; top: 0; height: 100%; transform: none; }
    }

    /* ----- Process steps stick & overlap one another as you scroll ----- */
    .process-step { position: sticky; background: #faf9f8; }
    .process-step:nth-child(1) { top: 92px; }
    .process-step:nth-child(2) { top: 124px; }
    .process-step:nth-child(3) { top: 156px; }
    @media (prefers-reduced-motion: reduce) {
      .process-step { position: static; box-shadow: none; }
    }

  </style>

  <!-- ===================== HERO HEADER ===================== -->
  <section id="hero" class="relative min-h-screen lg:h-screen overflow-hidden text-white bg-black" data-nav-theme="dark">
    <video class="absolute inset-0 w-full h-full object-cover" muted loop playsinline preload="none" data-webm="/assets/video/hero-0715.webm" data-mp4="/assets/video/hero-0715.mp4" poster="/assets/images/hero-poster-0715.webp" aria-hidden="true" tabindex="-1">
    </video>
    <div class="absolute inset-0 bg-black/70"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-black/45"></div>

    <!-- Hero content -->
    <div class="relative z-20 h-full w-full mx-auto max-w-[1920px] px-5 sm:px-10 lg:px-[60px] flex flex-col justify-end pb-16 sm:pb-24 lg:pb-[90px] pt-[130px] gap-5 lg:gap-6">
      <!-- Trust row -->
      <TrustPill />

      <div class="mx-auto max-w-[1050px] text-center">
        <h1 class="font-semibold capitalize leading-[1.03] tracking-[-0.03em] text-[clamp(3rem,6.8vw,6.05rem)] text-center">
          Explore Our Custom Home Additions
        </h1>
        <p class="mt-6 text-[clamp(0.95rem,1.2vw,1.15rem)] font-medium leading-[1.55] tracking-[-0.02em] text-[#eaeaea] max-w-[620px] mx-auto">
          Custom showers, tile and natural stone, and hard-surface flooring — designed, waterproofed, and installed by a detail-obsessed family crew with 22 years on Florida's Gulf Coast.
        </p>
      </div>

      <div class="flex flex-col items-center gap-8">
        <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-center sm:justify-center gap-3 sm:gap-4 w-full sm:w-auto">
          <a href="#estimate" class="btn js-open-estimate w-full sm:w-auto text-center bg-brand hover:bg-[#c23c18] rounded-full px-8 py-3.5 text-[18px] font-semibold capitalize text-white">Free Estimate</a>
          <a href="tel:+15037814657" class="btn w-full sm:w-auto text-center border border-[#a3a3a3] hover:border-white hover:bg-white/10 rounded-full px-8 py-3.5 text-[18px] font-semibold capitalize text-[#f2f2f2]">(503) 781-4657</a>
        </div>

        <!-- Bottom row: stats on the left, the marks we build to on the right.
             Capped narrower than the hero's 1920 grid and centred, so on a wide
             screen the two ends pull in off the edges. -->
        <div class="w-full flex flex-col gap-8 lg:mt-[120px] lg:mx-auto lg:max-w-[1180px] lg:flex-row lg:items-end lg:justify-between">
          <div class="grid grid-cols-3 gap-x-3 sm:gap-x-8 gap-y-5 lg:flex lg:flex-wrap lg:justify-start">
            <div class="flex flex-col items-start">
              <span class="font-normal text-[1.7rem] sm:text-[clamp(2rem,3vw,2.8rem)] leading-[1.085] tracking-[-0.04em]"><span class="stat-num" data-count="22">22</span>+</span>
              <span class="font-poppins text-[10.5px] sm:text-[14px] font-medium capitalize text-[#e9e9e9] tracking-[-0.03em] leading-[1.25]">Years of <br class="sm:hidden" />excellence</span>
            </div>
            <div class="flex flex-col items-start">
              <span class="font-normal text-[1.7rem] sm:text-[clamp(2rem,3vw,2.8rem)] leading-[1.085] tracking-[-0.04em]"><span class="stat-num" data-count="100">100</span>%</span>
              <span class="font-poppins text-[10.5px] sm:text-[14px] font-medium capitalize text-[#e9e9e9] tracking-[-0.03em] leading-[1.25]">Full Warranty <br class="sm:hidden" />Coverage</span>
            </div>
            <div class="flex flex-col items-start">
              <span class="font-normal text-[1.7rem] sm:text-[clamp(2rem,3vw,2.8rem)] leading-[1.085] tracking-[-0.04em]"><span class="stat-num" data-count="1300">1300</span>+</span>
              <span class="font-poppins text-[10.5px] sm:text-[14px] font-medium capitalize text-[#e9e9e9] tracking-[-0.03em] leading-[1.25]">Projects <br class="sm:hidden" />Completed</span>
            </div>
          </div>
          <!-- Credential marks: each logo carries its own claim, so the row states
               what the badges mean. Reversed (white-on-transparent) marks, so they
               read on the dark hero; images are decorative — the label names them. -->
          <div class="hidden sm:flex items-center gap-5 sm:gap-7 lg:mr-9 lg:translate-y-[10px]">
            <div class="flex items-center gap-2.5 sm:gap-3.5">
              <img loading="lazy" decoding="async" src="/assets/images/brand/schluter-white.webp" width="408" height="240" alt="" class="block h-9 sm:h-11 w-auto opacity-90" />
              <p class="shrink-0 font-poppins text-[11px] sm:text-[14px] font-medium text-[#e9e9e9] tracking-[-0.03em] leading-[1.25]">Schluter®<br />Certified</p>
            </div>
            <span class="h-8 sm:h-10 w-px shrink-0 bg-white/20" aria-hidden="true"></span>
            <div class="flex items-center gap-2.5 sm:gap-3.5">
              <img loading="lazy" decoding="async" src="/assets/images/brand/ntca-white.webp" width="240" height="240" alt="" class="block h-14 sm:h-[66px] w-auto opacity-90" />
              <p class="shrink-0 font-poppins text-[11px] sm:text-[14px] font-medium text-[#e9e9e9] tracking-[-0.03em] leading-[1.25]">NTCA<br />Member</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== SERVICE 1 — CUSTOM SHOWERS ===================== -->
  <section id="custom-showers" class="bg-white" data-nav-theme="light">
    <div class="mx-auto max-w-[1920px] px-5 sm:px-10 lg:px-[60px] py-20 lg:py-[110px]">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <!-- Image -->
        <div class="card relative overflow-hidden aspect-[4/5] lg:order-1">
          <img loading="lazy" decoding="async" src="/assets/images/card-bath.webp" alt="Custom tiled walk-in shower with built-in niche and frameless glass" class="card-img w-full h-full object-cover" />
          <img loading="lazy" decoding="async" src="/assets/images/card-bath-hover.webp" alt="" aria-hidden="true" class="card-img-hover absolute inset-0 w-full h-full object-cover" />
        </div>
        <!-- Content -->
        <div class="lg:order-2">
          <h2 class="font-semibold capitalize leading-[1.03] tracking-[-0.04em] text-[clamp(2.75rem,5vw,4.5rem)]">Custom Showers</h2>
          <p class="mt-5 text-[15.5px] leading-[1.7] tracking-[-0.01em] text-graydesc max-w-[560px]">
            Curbless entries, built-in niches, and bench seats over a waterproofing system engineered to stay leak-free for decades. We build showers to spa standards — every slope, seam, and grout line set by hand.
          </p>
          <ul class="mt-8 grid gap-x-8 gap-y-3.5 sm:grid-cols-2 max-w-[560px]">
            <li class="flex items-center gap-3 text-[15px] font-medium tracking-[-0.02em] text-ink"><span class="feat-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg></span>Schluter® waterproofing</li>
            <li class="flex items-center gap-3 text-[15px] font-medium tracking-[-0.02em] text-ink"><span class="feat-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg></span>Curbless &amp; barrier-free entries</li>
            <li class="flex items-center gap-3 text-[15px] font-medium tracking-[-0.02em] text-ink"><span class="feat-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg></span>Built-in niches &amp; benches</li>
            <li class="flex items-center gap-3 text-[15px] font-medium tracking-[-0.02em] text-ink"><span class="feat-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg></span>Linear &amp; point drains</li>
            <li class="flex items-center gap-3 text-[15px] font-medium tracking-[-0.02em] text-ink"><span class="feat-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg></span>Frameless glass coordination</li>
            <li class="flex items-center gap-3 text-[15px] font-medium tracking-[-0.02em] text-ink"><span class="feat-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg></span>Steam-shower ready</li>
          </ul>
          <!-- TODO: build the dedicated /services/custom-showers page -->
          <a href="/services/custom-showers/" class="btn group mt-9 inline-flex items-center gap-2 rounded-full bg-brand hover:bg-[#c23c18] px-8 py-3.5 text-[15px] font-semibold capitalize text-white hover:gap-3">
            Explore Custom Showers
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== SERVICE 2 — TILE & NATURAL STONE ===================== -->
  <section id="tile-stone" class="bg-[#faf9f8]" data-nav-theme="light">
    <div class="mx-auto max-w-[1920px] px-5 sm:px-10 lg:px-[60px] py-20 lg:py-[110px]">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <!-- Image (right on desktop) -->
        <div class="card relative overflow-hidden aspect-[4/5] lg:order-2">
          <img loading="lazy" decoding="async" src="/assets/images/card-kitchen.webp" alt="Kitchen backsplash and countertop in natural stone and porcelain tile" class="card-img w-full h-full object-cover" />
          <img loading="lazy" decoding="async" src="/assets/images/card-kitchen-hover.webp" alt="" aria-hidden="true" class="card-img-hover absolute inset-0 w-full h-full object-cover" />
        </div>
        <!-- Content -->
        <div class="lg:order-1">
          <h2 class="font-semibold capitalize leading-[1.03] tracking-[-0.04em] text-[clamp(2.75rem,5vw,4.5rem)]">Tile &amp; Natural Stone</h2>
          <p class="mt-5 text-[15.5px] leading-[1.7] tracking-[-0.01em] text-graydesc max-w-[560px]">
            From large-format porcelain to marble mosaics and statement feature walls — precise layouts, tight grout lines, and finishes that read as one continuous surface. We plan every cut before the first tile is set.
          </p>
          <ul class="mt-8 grid gap-x-8 gap-y-3.5 sm:grid-cols-2 max-w-[560px]">
            <li class="flex items-center gap-3 text-[15px] font-medium tracking-[-0.02em] text-ink"><span class="feat-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg></span>Large-format &amp; porcelain slab</li>
            <li class="flex items-center gap-3 text-[15px] font-medium tracking-[-0.02em] text-ink"><span class="feat-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg></span>Marble &amp; quartzite stone</li>
            <li class="flex items-center gap-3 text-[15px] font-medium tracking-[-0.02em] text-ink"><span class="feat-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg></span>Herringbone &amp; custom patterns</li>
            <li class="flex items-center gap-3 text-[15px] font-medium tracking-[-0.02em] text-ink"><span class="feat-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg></span>Backsplashes &amp; feature walls</li>
            <li class="flex items-center gap-3 text-[15px] font-medium tracking-[-0.02em] text-ink"><span class="feat-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg></span>Heated floor systems</li>
            <li class="flex items-center gap-3 text-[15px] font-medium tracking-[-0.02em] text-ink"><span class="feat-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg></span>Sealing &amp; care guidance</li>
          </ul>
          <!-- TODO: build the dedicated /services/tile-natural-stone page -->
          <a href="/services/tile-natural-stone/" class="btn group mt-9 inline-flex items-center gap-2 rounded-full bg-brand hover:bg-[#c23c18] px-8 py-3.5 text-[15px] font-semibold capitalize text-white hover:gap-3">
            Explore Tile &amp; Stone
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== SERVICE 3 — HARD SURFACE FLOORING ===================== -->
  <section id="flooring" class="bg-white" data-nav-theme="light">
    <div class="mx-auto max-w-[1920px] px-5 sm:px-10 lg:px-[60px] py-20 lg:py-[110px]">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <!-- Image -->
        <div class="card relative overflow-hidden aspect-[4/5] lg:order-1">
          <img loading="lazy" decoding="async" src="/assets/images/card-home.webp" alt="Wide-plank hardwood flooring in an open living space" class="card-img w-full h-full object-cover" />
          <img loading="lazy" decoding="async" src="/assets/images/card-home-hover.webp" alt="" aria-hidden="true" class="card-img-hover absolute inset-0 w-full h-full object-cover" />
        </div>
        <!-- Content -->
        <div class="lg:order-2">
          <h2 class="font-semibold capitalize leading-[1.03] tracking-[-0.04em] text-[clamp(2.75rem,5vw,4.5rem)]">Flooring</h2>
