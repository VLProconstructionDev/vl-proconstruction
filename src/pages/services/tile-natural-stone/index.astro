  <script is:inline>
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Count-up animation for hero stats
    const nums = document.querySelectorAll('.stat-num');
    const fmt = (v, d) => d ? v.toFixed(d) : String(Math.round(v));
    const runCount = (el) => {
      const target = parseFloat(el.dataset.count);
      const dec = (el.dataset.count.split('.')[1] || '').length;
      const duration = 1500; let st = null;
      const tick = (now) => { if (st === null) st = now; const p = Math.min((now - st) / duration, 1); const e = 1 - Math.pow(1 - p, 3); el.textContent = fmt(target * e, dec); if (p < 1) requestAnimationFrame(tick); else el.textContent = fmt(target, dec); };
      requestAnimationFrame(tick);
    };
    if (reduceMotion || !('IntersectionObserver' in window)) {
      nums.forEach((el) => { el.textContent = fmt(parseFloat(el.dataset.count), (el.dataset.count.split('.')[1] || '').length); });
    } else {
      nums.forEach((el) => { el.textContent = fmt(0, (el.dataset.count.split('.')[1] || '').length); });
      const io = new IntersectionObserver((entries) => { entries.forEach((e) => { if (e.isIntersecting) { runCount(e.target); io.unobserve(e.target); } }); }, { threshold: 0.6 });
      nums.forEach((el) => io.observe(el));
    }

    // Reviews quote carousel
    const revQuote = document.getElementById('revQuote');
    if (revQuote) {
      const reviews = [
        { name: 'Paul Lipowicz', role: '', quote: "Abel and his brothers are top notch installers. I have been in the industry for 20 years and know great installers when I see them. I hired them to do a marble backsplash for me and they were extremely clean, calculated, presentable, and meticulous. They do things right the first time and take pride in their knowledge and work. Definitely will be using them again soon on other properties!", img: '/assets/images/review-1.webp', avatar: '/assets/images/review-1-avatar.webp' },
        { name: 'Valeriy Tsinovkin', role: '', quote: "I recently had my kitchen remodeled and couldn't be happier with the results. The entire process was smooth and professional, and the team kept everything clean and organized throughout the project. The craftsmanship and attention to detail were excellent, and my kitchen looks stunning. Highly recommend to anyone looking for a high-quality, hassle-free remodel.", img: '/assets/images/review-2.webp', avatar: '/assets/images/review-2-avatar.webp' },
        { name: 'Avetal Mor', role: '', quote: "Absolutely amazing work fixed our floors after hurricane!", img: '/assets/images/review-3.webp', avatar: '/assets/images/review-3-avatar.webp' },
        { name: 'Stacy Ramirez', role: '', quote: "Vlad and his team are phenomenal! We couldn't be happier with our new master bath. Their attention to detail is unmatched. They showed up, communicated well, and offered quality suggestions. We highly recommend and will use them for our next home project.", img: '/assets/images/review-4.webp', avatar: '/assets/images/review-4-avatar.webp' },
      ];
      const revName = document.getElementById('revName');
      const revRole = document.getElementById('revRole');
      const revImg = document.getElementById('revImg');
      const revAvatar = document.getElementById('revAvatar');
      const fades = [document.getElementById('revMeta'), revQuote.closest('.rev-fade'), revImg.closest('.rev-fade')];
      let i = 0;
      const paint = () => {
        const r = reviews[i];
        revName.textContent = r.name;
        revRole.textContent = r.role;
        revRole.classList.toggle('hidden', !r.role);
        revQuote.textContent = r.quote;
        revImg.src = r.img;
        revAvatar.src = r.avatar;
        syncDots();
      };
      const quoteCol = revQuote.closest('.rev-fade').parentElement;
      const lockHeight = () => {
        const current = reviews[i].quote;
        quoteCol.style.minHeight = '';
        let max = 0;
        reviews.forEach((r) => { revQuote.textContent = r.quote; max = Math.max(max, quoteCol.offsetHeight); });
        revQuote.textContent = current;
        quoteCol.style.minHeight = max + 'px';
      };
      // Pagination dots — one per review; click jumps straight to it
      const dotsWrap = document.getElementById('revDots');
      let dots = [];
      const syncDots = () => dots.forEach((d, n) => {
        d.classList.toggle('is-active', n === i);
        d.setAttribute('aria-current', n === i ? 'true' : 'false');
      });
      let animating = false;
      const go = (dir) => {
        if (animating) return;
        i = (i + dir + reviews.length) % reviews.length;
        if (reduceMotion) { paint(); return; }
        animating = true;
        const outX = dir > 0 ? -36 : 36;
        const inX = dir > 0 ? 36 : -36;
        fades.forEach((el) => { el.style.opacity = '0'; el.style.transform = `translateX(${outX}px)`; });
        setTimeout(() => {
          paint();
          fades.forEach((el) => { el.style.transition = 'none'; el.style.transform = `translateX(${inX}px)`; });
          void document.body.offsetWidth;
          requestAnimationFrame(() => {
            fades.forEach((el) => { el.style.transition = ''; el.style.opacity = '1'; el.style.transform = 'translateX(0)'; });
            setTimeout(() => { animating = false; }, 450);
          });
        }, 350);
      };
      let timer = null;
      const start = () => { timer = setInterval(() => go(1), 5000); };
      const reset = () => { clearInterval(timer); start(); };
      document.getElementById('revPrev').addEventListener('click', () => { go(-1); reset(); });
      document.getElementById('revNext').addEventListener('click', () => { go(1); reset(); });
      const reviewsSection = document.getElementById('reviews');
      reviewsSection.addEventListener('mouseenter', () => clearInterval(timer));
      reviewsSection.addEventListener('mouseleave', start);
      // Finger swipe (mobile): a horizontal drag advances the carousel. Vertical drags
      // fall through to normal page scroll (we only act on mostly-horizontal gestures).
      let touchX = null, touchY = null;
      reviewsSection.addEventListener('touchstart', (e) => {
        touchX = e.changedTouches[0].clientX;
        touchY = e.changedTouches[0].clientY;
      }, { passive: true });
      reviewsSection.addEventListener('touchend', (e) => {
        if (touchX === null) return;
        const dx = e.changedTouches[0].clientX - touchX;
        const dy = e.changedTouches[0].clientY - touchY;
        touchX = touchY = null;
        if (Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(dy)) return; // ignore taps/vertical
        go(dx < 0 ? 1 : -1); // swipe left → next, swipe right → prev
        reset();
      }, { passive: true });
      lockHeight();
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(lockHeight);
      let revResizeT = null;
      window.addEventListener('resize', () => { clearTimeout(revResizeT); revResizeT = setTimeout(lockHeight, 150); }, { passive: true });
      if (dotsWrap) {
        dots = reviews.map((r, n) => {
          const d = document.createElement('button');
          d.type = 'button';
          d.className = 'rev-dot';
          d.setAttribute('role', 'tab');
          d.setAttribute('aria-label', 'Show review ' + (n + 1) + ' of ' + reviews.length);
          d.addEventListener('click', () => { if (n !== i) { go(n - i); reset(); } });
          dotsWrap.appendChild(d);
          return d;
        });
        syncDots();
      }
      start();
    }

    // FAQ accordion — single-open; content stays visible if JS is unavailable
    const faqList = document.getElementById('faqList');
    if (faqList) {
      faqList.classList.add('js-faq');
      const fitems = [...faqList.querySelectorAll('.faq-item')].map((item) => ({ q: item.querySelector('.faq-q'), a: item.querySelector('.faq-a') }));
      const collapse = (it) => { it.q.setAttribute('aria-expanded', 'false'); it.a.style.height = '0px'; };
      const expand = (it) => { it.q.setAttribute('aria-expanded', 'true'); it.a.style.height = it.a.scrollHeight + 'px'; };
      fitems.forEach((it) => { collapse(it); it.q.addEventListener('click', () => { const isOpen = it.q.getAttribute('aria-expanded') === 'true'; fitems.forEach(collapse); if (!isOpen) expand(it); }); });
      window.addEventListener('resize', () => { const open = fitems.find((it) => it.q.getAttribute('aria-expanded') === 'true'); if (open) open.a.style.height = open.a.scrollHeight + 'px'; }, { passive: true });
    }

    // Parallax process photos — each image drifts within its frame as the section scrolls
    const pxImgs = [...document.querySelectorAll('.px-img')];
    if (pxImgs.length && !reduceMotion) {
      let pxTicking = false;
      const renderParallax = () => {
        const vh = window.innerHeight;
        pxImgs.forEach((img) => {
          const frame = img.parentElement;
          const r = frame.getBoundingClientRect();
          if (r.bottom < 0 || r.top > vh) return;
          const progress = (r.top + r.height / 2 - vh / 2) / (vh / 2 + r.height / 2);
          const shift = frame.offsetHeight * 0.20;
          img.style.transform = `translateY(${(progress * shift).toFixed(1)}px)`;
        });
        pxTicking = false;
      };
      const onPxScroll = () => { if (!pxTicking) { pxTicking = true; requestAnimationFrame(renderParallax); } };
      window.addEventListener('scroll', onPxScroll, { passive: true });
      window.addEventListener('resize', onPxScroll, { passive: true });
      renderParallax();
    }

    // Vertical auto-scrolling photo wall
    {
      const gWall = document.getElementById('galleryWall');
      if (gWall) {
        // Real tile & natural stone job photos (client set, Aug 2026). Six of the
        // twelve the client picked for this page are the same files they picked
        // for /services/custom-showers, so those are referenced out of
        // gallery-showers-2026 instead of being shipped twice.
        const gPhotos = [
          '/assets/images/gallery-tile-2026/tile-1.webp','/assets/images/gallery-showers-2026/showers-1.webp',
          '/assets/images/gallery-tile-2026/tile-2.webp','/assets/images/gallery-showers-2026/showers-6.webp',
          '/assets/images/gallery-tile-2026/tile-3.webp','/assets/images/gallery-showers-2026/showers-7.webp',
          '/assets/images/gallery-tile-2026/tile-4.webp','/assets/images/gallery-showers-2026/showers-8.webp',
          '/assets/images/gallery-tile-2026/tile-5.webp','/assets/images/gallery-showers-2026/showers-10.webp',
          '/assets/images/gallery-tile-2026/tile-6.webp','/assets/images/gallery-showers-2026/showers-12.webp',
        ];
        const gDur = [40, 32, 46, 36, 42];
        const gColsFor = (w) => (w >= 1024 ? 4 : w >= 640 ? 3 : 2);
        let gBuilt = 0;
        const gCell = (src) => `<div class="vcell overflow-hidden aspect-[4/5]"><img src="${src}" alt="VL Proconstruction project" loading="lazy" class="gallery-img w-full h-full object-cover"/></div>`;
        const gBuild = () => {
          const n = gColsFor(window.innerWidth);
          if (n === gBuilt && gWall.childElementCount) return;
          gBuilt = n;
          // Split the list into n CONTIGUOUS slices — never a round-robin, which used
          // to drop the same photo into neighbouring columns a row apart. A short slice
          // repeats inside its OWN column (>= 3 cells) so the doubled set always covers
          // the wall height; no photo is ever shared between two columns.
          const gBase = Math.floor(gPhotos.length / n), gExtra = gPhotos.length % n;
          let gAt = 0;
          const cols = Array.from({ length: n }, (_, ci) => {
            let cells = gPhotos.slice(gAt, gAt + gBase + (ci < gExtra ? 1 : 0));
            gAt += cells.length;
            if (!cells.length) cells = [gPhotos[ci % gPhotos.length]];
            while (cells.length < 3) cells = cells.concat(cells);
            return cells;
          });
          gWall.innerHTML = cols.map((imgs, ci) => {
            const set = imgs.map(gCell).join('');
            const dir = ci % 2 ? ' vcol-down' : '';
            const dur = gDur[ci % gDur.length];
            return `<div class="vcol${dir}" style="animation-duration:${dur}s">${set}${set}</div>`;
          }).join('');
        };
        // Build only when the wall approaches the viewport (see home page note):
        // building at load fetches every wall photo immediately on mobile.
        let gReady = false;
        const gBuildOnce = () => {
          if (gReady) return;
          gReady = true;
          gBuild();
          let gResizeT;
          window.addEventListener("resize", () => { clearTimeout(gResizeT); gResizeT = setTimeout(gBuild, 200); }, { passive: true });
        };
        if ("IntersectionObserver" in window) {
          const gIo = new IntersectionObserver((entries) => {
            if (entries.some((e) => e.isIntersecting)) { gIo.disconnect(); gBuildOnce(); }
          }, { rootMargin: "1200px 0px" });
          gIo.observe(gWall);
        } else {
          gBuildOnce();
        }
      }
    }
  </script>
</BaseLayout>
