---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@components/PostCard.astro';
import EstimateInline from '@components/EstimateInline.astro';
import { sortPosts, visible } from '@/lib/blog';
import { breadcrumbSchema } from '@/lib/schema';
import { site } from '@/lib/site';

const posts = sortPosts(await getCollection('blog', visible));

const schema = [
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Blog', url: '/blog' },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: `${site.name} — Advice & Insights`,
    url: `${site.url}/blog`,
    blogPost: posts.map((p) => ({
      '@type': 'BlogPosting',
      headline: p.data.title,
      description: p.data.description,
      url: `${site.url}/blog/${p.id}`,
      datePublished: p.data.publishedAt.toISOString(),
    })),
  },
];
---

<BaseLayout
  title="Tile, Flooring & Shower Guides"
  description="Field notes from our crew on tile, natural stone, hard-surface flooring, and custom showers for homes across Bradenton and Sarasota."
  schema={schema}
  navTheme="light"
>
  <style is:global>
    body { font-family: 'Inter', system-ui, sans-serif; }
  </style>

  <!-- Header — plain light band; the fixed navbar needs the top clearance. -->
  <section class="bg-white" data-nav-theme="light">
    <div class="mx-auto max-w-[1920px] px-5 sm:px-10 lg:px-[60px] pt-[140px] lg:pt-[180px] pb-10 lg:pb-14">
      <h1 class="font-bold capitalize text-ink leading-[1.02] tracking-[-0.03em] text-[clamp(2.4rem,5.5vw,4.5rem)]">
        Advice &amp; insights
      </h1>
      <p class="mt-5 text-[15px] leading-[1.7] tracking-[-0.01em] text-graydesc max-w-[620px]">
        Straight from the job site — what we install, why we install it that way, and what
        to know before you hire a crew on the Suncoast.
      </p>
    </div>
  </section>

  <!-- Post list — same .bl-* cards as the home-page teaser. -->
  <section class="bg-white" data-nav-theme="light">
    <div class="mx-auto max-w-[1920px] px-5 sm:px-10 lg:px-[60px] pb-20 lg:pb-[110px]">
      {posts.length === 0 ? (
        <p class="text-[15px] leading-[1.7] text-graydesc">
          No posts yet. Call us at
          <a href={site.phoneHref} class="text-brand hover:underline">{site.phone}</a>
          and we'll answer your question directly.
        </p>
      ) : (
        <div class="grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => <PostCard post={post} showNew={false} />)}
        </div>
      )}
    </div>
  </section>

  <!-- Closing form — inline step 1 of the estimate wizard. -->
  <EstimateInline />
</BaseLayout>
