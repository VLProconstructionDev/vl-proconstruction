---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { breadcrumbSchema } from '@/lib/schema';
import { site } from '@/lib/site';

const locations = (await getCollection('locations', ({ data }) => data.published)).sort(
  (a, b) => a.data.order - b.data.order,
);

// Group by state so bigger footprints stay scannable.
const byState = locations.reduce<Record<string, typeof locations>>((acc, loc) => {
  const key = loc.data.state;
  (acc[key] ??= []).push(loc);
  return acc;
}, {});

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Service Areas' },
];

const schema = [
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Service Areas', url: '/service-areas' },
  ]),
];
---

<BaseLayout
  title="Service Areas"
  description={`Cities and neighborhoods served by ${site.name}.`}
  schema={schema}
  navTheme="dark"
>
  <section class="relative overflow-hidden bg-ink text-white" data-nav-theme="dark">
    <div class="absolute inset-0 bg-gradient-to-br from-[#1a1a1a] via-[#0f0f0f] to-black"></div>
    <div class="relative mx-auto max-w-[1200px] px-5 sm:px-10 pt-[180px] pb-24">
      <p class="text-[12px] font-semibold uppercase tracking-[0.18em] text-brand">
        Where we work
      </p>
      <h1 class="mt-4 text-4xl sm:text-6xl lg:text-[76px] font-semibold tracking-[-0.03em] leading-[1.02]">
        Service Areas
      </h1>
      <p class="mt-6 max-w-[720px] text-lg text-white/75 leading-[1.65]">
        Cities and neighborhoods across Florida's Gulf Coast.
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-[1200px] px-5 sm:px-10 pt-10">
    <Breadcrumbs items={crumbs} />
  </div>

  <section class="mx-auto max-w-[1200px] px-5 sm:px-10 mt-14 mb-24">
    {Object.entries(byState).map(([state, list]) => (
      <div class="mb-16">
        <h2 class="text-2xl font-semibold tracking-[-0.02em]">{state}</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {list.map((loc) => (
            <a
              href={`/service-areas/${loc.id}`}
              class="group flex flex-col rounded-2xl border border-black/10 bg-white p-6 transition-transform hover:-translate-y-0.5"
            >
              <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-graycard">
                {loc.data.county ?? loc.data.state}
              </p>
              <h3 class="mt-3 text-xl font-semibold tracking-[-0.02em] text-ink">
                {loc.data.name}, {loc.data.state}
              </h3>
              {loc.data.neighborhoods.length > 0 && (
                <p class="mt-2 text-[14px] text-graydesc line-clamp-2">
                  {loc.data.neighborhoods.slice(0, 4).join(' · ')}
                </p>
              )}
              <span class="mt-4 inline-flex items-center gap-1.5 text-[14px] font-medium text-brand">
                See services
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>
</BaseLayout>
