---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { articleSchema, breadcrumbSchema } from '@/lib/schema';
import { site } from '@/lib/site';

export async function getStaticPaths() {
  const isProd = import.meta.env.PROD;
  const posts = await getCollection('blog', ({ data }) => (isProd ? !data.draft : true));
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const p = post.data;

const relatedService = p.relatedService
  ? await getEntry('services', p.relatedService)
  : undefined;
const relatedLocation = p.relatedLocation
  ? await getEntry('locations', p.relatedLocation)
  : undefined;

const canonical = `/blog/${post.id}`;

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog' },
  { name: p.title },
];

const schema = [
  articleSchema({
    title: p.title,
    description: p.description,
    slug: post.id,
    datePublished: p.publishedAt.toISOString(),
    dateModified: p.updatedAt?.toISOString(),
    image: p.heroImage,
    author: p.author,
  }),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Blog', url: '/blog' },
    { name: p.title, url: canonical },
  ]),
];

const fmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---

<BaseLayout
  title={p.title}
  description={p.description}
  image={p.heroImage}
  schema={schema}
  canonical={canonical}
  navTheme="dark"
>
  <article>
    <header class="relative overflow-hidden bg-ink text-white" data-nav-theme="dark">
      <div class="absolute inset-0">
        {p.heroImage ? (
          <img src={p.heroImage} alt="" aria-hidden="true" class="h-full w-full object-cover opacity-40" />
        ) : (
          <div class="h-full w-full bg-gradient-to-br from-[#1a1a1a] via-[#0f0f0f] to-black"></div>
        )}
        <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/50 to-black/30"></div>
      </div>
      <div class="relative mx-auto max-w-[820px] px-5 sm:px-10 pt-[180px] pb-24 lg:pt-[220px]">
        <p class="text-[12px] font-semibold uppercase tracking-[0.18em] text-brand">
          {fmt.format(p.publishedAt)}
          {p.draft && <span class="ml-2 text-white/70">DRAFT</span>}
        </p>
        <h1 class="mt-4 text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-[-0.03em] leading-[1.05]">
          {p.title}
        </h1>
        <p class="mt-6 text-lg text-white/75 leading-[1.65] max-w-[640px]">
          {p.description}
        </p>
      </div>
    </header>

    <div class="mx-auto max-w-[820px] px-5 sm:px-10 pt-10">
      <Breadcrumbs items={crumbs} />
    </div>

    <div class="mx-auto max-w-[720px] px-5 sm:px-10 mt-12 prose prose-lg prose-headings:tracking-[-0.02em] prose-a:text-brand">
      <Content />
    </div>

    {(relatedService || relatedLocation) && (
      <section class="mx-auto max-w-[720px] px-5 sm:px-10 mt-16 mb-24">
        <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-graycard">
          Related
        </p>
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          {relatedService && (
            <a
              href={`/services/${relatedService.id}`}
              class="group flex items-center justify-between gap-3 rounded-xl border border-black/10 p-4 hover:border-brand/40 transition-colors"
            >
              <div>
                <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-graycard">Service</p>
                <p class="mt-1 text-[15px] font-medium text-ink">{relatedService.data.shortName}</p>
              </div>
              <svg class="w-4 h-4 text-brand transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </a>
          )}
          {relatedLocation && (
            <a
              href={`/service-areas/${relatedLocation.id}`}
              class="group flex items-center justify-between gap-3 rounded-xl border border-black/10 p-4 hover:border-brand/40 transition-colors"
            >
              <div>
                <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-graycard">Service Area</p>
                <p class="mt-1 text-[15px] font-medium text-ink">{relatedLocation.data.name}, {relatedLocation.data.state}</p>
              </div>
              <svg class="w-4 h-4 text-brand transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </a>
          )}
        </div>
      </section>
    )}

    <section class="mx-auto max-w-[1200px] px-5 sm:px-10 mb-24">
      <div class="rounded-3xl bg-ink text-white p-10 sm:p-14">
        <p class="text-[12px] font-semibold uppercase tracking-[0.18em] text-brand">Ready to start?</p>
        <h2 class="mt-3 text-3xl sm:text-5xl font-semibold tracking-[-0.03em] max-w-[720px]">
          Get a free estimate on your project.
        </h2>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="#estimate" class="btn js-open-estimate inline-flex items-center h-12 px-7 rounded-full bg-brand hover:bg-[#e03f1c] text-white font-semibold text-[15px] capitalize">
            Get a Free Estimate
          </a>
          <a href={site.phoneHref} class="btn inline-flex items-center h-12 px-6 rounded-full border border-white/20 hover:border-white text-white font-medium text-[15px]">
            Call {site.phone}
          </a>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
