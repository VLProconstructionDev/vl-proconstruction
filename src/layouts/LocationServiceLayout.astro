---
/**
 * City × service page shell — /locations/[city]/[service].
 *
 * Driven entirely by one `cityServices` entry (plus the matching `locations` /
 * `services` entries for names). Every section's UI is lifted from an existing
 * live page — see the comment above each one for where it came from — so these
 * pages stay visually identical to the rest of the site.
 */
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ServiceAreaMap from '@components/ServiceAreaMap.astro';
import { site } from '@/lib/site';
import { serviceSchema, breadcrumbSchema } from '@/lib/schema';
import { cityServicePath } from '@/lib/urls';
import TrustPill from '@components/TrustPill.astro';
import ReviewsSection from '@components/ReviewsSection.astro';

interface Props {
  entry: CollectionEntry<'cityServices'>;
  location: CollectionEntry<'locations'>;
  service: CollectionEntry<'services'>;
}

const { entry, location, service } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

// The card carousel wants { quote, name, meta } — the neighborhood is this
// city's version of the small line in a card's bottom-right corner.
const cityReviews = d.reviews.map((r) => ({ quote: r.quote, name: r.name, meta: r.neighborhood }));

// Phones get a still job photo where desktop plays the hero clip — the same
// shot each service wears on the home-page card.
const HERO_PHOTO: Record<string, string> = {
  'custom-showers': '/assets/images/card-bath.webp',
  'tile-natural-stone': '/assets/images/card-kitchen.webp',
  'hard-surface-flooring': '/assets/images/card-home.webp',
  flooring: '/assets/images/card-home.webp',
};
const heroPhoto = HERO_PHOTO[service.id] ?? '/assets/images/hero-poster-0715.webp';

const cityState = `${location.data.name}, ${location.data.state}`;
const path = cityServicePath(location, service.id);

const schema = [
  serviceSchema({
    name: `${service.data.title} in ${cityState}`,
    description: d.seoDescription,
    slug: service.id,
    areaServed: cityState,
    url: path,
  }),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Services', url: '/services' },
    { name: service.data.shortName, url: `/services/${service.id}` },
    { name: location.data.name, url: path },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

/** Trust-card icons — same 24px stroke set used on the service pages. */
const ICONS = {
  check: '<path d="M20 6 9 17l-5-5"/>',
  badge:
    '<path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M12 15.6c-1.3-1-3-2-3-3.4 0-1.4 1.9-2.4 3-1 1.1-1.4 3-.4 3 1 0 1.4-1.7 2.4-3 3.4z"/>',
  crew: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.2 1.9"/>',
  map: '<path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11z"/><circle cx="12" cy="10" r="2.6"/>',
  shield: '<path d="M12 3l7.5 3v5.5c0 4.6-3.1 8.3-7.5 9.5-4.4-1.2-7.5-4.9-7.5-9.5V6z"/><path d="m9 12 2.2 2.2L15.5 10"/>',
} as const;

/**
 * The "Keep looking" cross-links at the foot of the page are parked for now —
 * flip to true to bring the block back. The `related` data stays in each
 * city-services file, so nothing has to be rewritten.
 */
const SHOW_RELATED = false;
---

<BaseLayout
  title={d.seoTitle ?? `${service.data.shortName} in ${cityState} — ${site.name}`}
  description={d.seoDescription}
  canonical={path}
  schema={schema}
  navTheme="dark"
>
  <style is:global>
    /* ---- lifted from the service pages ---- */
    .svc-other { transition: border-color .2s, background-color .2s, transform .2s cubic-bezier(.22,1,.36,1); }
    .svc-other:hover { border-color: rgba(245,75,37,.5); background: rgba(255,255,255,.08); transform: translateY(-2px); }
    .svc-other:focus-visible { outline: 2px solid #f54b25; outline-offset: 3px; }

    .svc-tile { display: flex; flex-direction: column; }
    .svc-figure { position: relative; overflow: hidden; aspect-ratio: 4 / 5; background: #141414; }
    .svc-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .svc-title { margin-top: 18px; color: #1e1e1e; font-weight: 600; line-height: 1.15; letter-spacing: -.028em; font-size: clamp(1.2rem, 1.45vw, 1.55rem); }
    .svc-desc { margin-top: 10px; color: #4e4e4e; font-size: 12px; line-height: 1.5; max-width: 42ch; }

    /* ----- FAQ accordion ----- */
    .faq-item { border-bottom: 1px solid rgba(0,0,0,.1); }
    .faq-item:first-child { border-top: 1px solid rgba(0,0,0,.1); }
    .faq-q { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 28px; text-align: left; padding: 26px 0; cursor: pointer; color: #1e1e1e; }
    .faq-ico { position: relative; flex: none; width: 24px; height: 24px; }
    .faq-ico::before, .faq-ico::after { content: ""; position: absolute; background: #1e1e1e; transition: transform .3s ease, opacity .3s ease; }
    .faq-ico::before { top: 50%; left: 0; right: 0; height: 2px; transform: translateY(-50%); }
    .faq-ico::after { left: 50%; top: 0; bottom: 0; width: 2px; transform: translateX(-50%); }
    .faq-q[aria-expanded="true"] .faq-ico::after { transform: translateX(-50%) scaleY(0); opacity: 0; }
    .faq-q[aria-expanded="true"] .faq-ico::before { background: #f54b25; }
    .faq-a { overflow: hidden; }
    .faq-a-inner { padding-bottom: 26px; }
    .js-faq .faq-a { transition: height .32s cubic-bezier(.4,0,.2,1); }
    @media (prefers-reduced-motion: reduce) { .js-faq .faq-a { transition: none; } }

    /* ----- Process steps stick & overlap; parallax photos ----- */
    .px-frame { position: relative; overflow: hidden; }
    .process-step > * { min-width: 0; }
    /* Step 1 is a flat plan drawing — fills the frame still, no parallax crop */
    .px-frame .px-img.px-fit { position: absolute; inset: 0; top: 0; width: 100%; height: 100%; transform: none; }
    .px-frame .px-img { position: absolute; left: 0; top: -20%; width: 100%; height: 140%; object-fit: cover; will-change: transform; }
    @media (prefers-reduced-motion: reduce) { .px-frame .px-img { position: static; top: 0; height: 100%; transform: none; } }
    .process-step { position: sticky; background: #faf9f8; }
    .process-step:nth-child(1) { top: 92px; }
    .process-step:nth-child(2) { top: 124px; }
    .process-step:nth-child(3) { top: 156px; }
    @media (prefers-reduced-motion: reduce) { .process-step { position: static; } }

    /* ----- Project photo — same full-bleed frame the comparison slider used ----- */
    .proj-photo { position: relative; overflow: hidden; background: #111; aspect-ratio: 4 / 3; }
    @media (min-width: 1024px) { .proj-photo { aspect-ratio: 5 / 3; } }

    /* ----- Hairline data rows — same rule weight, padding and brand tint as the
       "VL vs others" table on the service pages; used for the project spec list
       and the pricing table. ----- */
    /* Project facts. Each stat carries its own top rule instead of vertical
       dividers, so the grid can wrap to two columns without a stray border. */
    .spec-label { font-size: 12.5px; font-weight: 600; letter-spacing: .01em; color: rgba(30,30,30,.45); }
    .spec-stat { border-top: 1px solid rgba(0,0,0,.14); padding-top: 18px; }
    .spec-value { margin-top: 10px; font-size: clamp(1.35rem, 1.9vw, 1.85rem); font-weight: 600; line-height: 1.15; letter-spacing: -.035em; color: #1e1e1e; }

    /* ----- Pricing tiers — three cards on Apple's neutral scale: white
       ground, white cards, #ebebed hairlines, #6e6e73 secondary text. The
       middle one is the one we want chosen, so it sits on the #f5f5f7 gray
       one step down from white, with a brand-colored label — the fill is its
       own edge, so it carries no border and no shadow. ----- */
    .tier { display: flex; flex-direction: column; background: #fff; border: 1px solid #ebebed; padding: 34px 30px 38px; }
    .tier-featured { background: #f5f5f7; border-color: transparent; }
    .tier-eyebrow { margin-top: 8px; font-size: 12.5px; font-weight: 600; letter-spacing: .01em; color: #6e6e73; }
    /* The label is the only sell signal on the card, so it carries the brand. */
    .tier-featured .tier-eyebrow { color: #c23c18; }
    .tier-price { font-size: clamp(2.05rem, 2.9vw, 2.85rem); font-weight: 600; line-height: 1.05; letter-spacing: -.04em; color: #1d1d1f; }
    .tier-rule { margin: 26px 0 24px; height: 1px; background: #d2d2d7; }
    .tier-list { display: grid; gap: 14px; }
    .tier-item { display: flex; align-items: flex-start; gap: 12px; font-size: 14.5px; line-height: 1.5; letter-spacing: -.01em; color: #4e4e4e; }
    .tier-check { flex: none; width: 18px; height: 18px; margin-top: 2px; color: #f54b25; }
    @media (max-width: 767px) { .tier { padding: 28px 24px 32px; } }

    /* ----- Service-area map edge fade (service-page values) ----- */
    .area-map-fade { -webkit-mask-image: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,.12) 3%, rgba(0,0,0,.45) 6%, rgba(0,0,0,.8) 10%, #000 14%); mask-image: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,.12) 3%, rgba(0,0,0,.45) 6%, rgba(0,0,0,.8) 10%, #000 14%); }
    @media (min-width: 1024px) {
      .area-map-fade { -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,.12) 3%, rgba(0,0,0,.45) 7%, rgba(0,0,0,.8) 11%, #000 15%); mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,.12) 3%, rgba(0,0,0,.45) 7%, rgba(0,0,0,.8) 11%, #000 15%); }
    }
    .area-map-fade::before { content: ''; position: absolute; inset: 0; z-index: 450; pointer-events: none;
      -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px);
      -webkit-mask-image: linear-gradient(to bottom, #000 0%, rgba(0,0,0,.55) 4%, rgba(0,0,0,.2) 8%, transparent 11%);
      mask-image: linear-gradient(to bottom, #000 0%, rgba(0,0,0,.55) 4%, rgba(0,0,0,.2) 8%, transparent 11%); }
    @media (min-width: 1024px) {
      .area-map-fade::before { -webkit-mask-image: linear-gradient(to right, #000 0%, rgba(0,0,0,.55) 4%, rgba(0,0,0,.2) 9%, transparent 12%);
        mask-image: linear-gradient(to right, #000 0%, rgba(0,0,0,.55) 4%, rgba(0,0,0,.2) 9%, transparent 12%); }
    }

    /* ----- Local expertise (dark "ground conditions" band) ----- */
    /* Intro prose sets up the conditions below it, so it reads a size larger. */
    .local-prose > p { margin-top: 15px; font-size: 15.5px; line-height: 1.7; letter-spacing: -.012em; color: rgba(255,255,255,.62); }
    .local-prose > p:first-child { margin-top: 0; }
    .local-prose strong { font-weight: 600; color: rgba(255,255,255,.9); }

    /* Spec-sheet ledger: condition on the left, what it changes on the right.
       Three parallel forces, not a sequence — hairline rows, no numbers. */
    .lx-item { border-top: 1px solid rgba(255,255,255,.14); padding: 20px 0 4px; display: grid; gap: 6px 40px; }
    .lx-item:last-child { border-bottom: 1px solid rgba(255,255,255,.14); padding-bottom: 22px; }
    .lx-head { font-size: 15.5px; font-weight: 600; line-height: 1.35; letter-spacing: -.02em; color: #fff; }
    .lx-body { font-size: 14px; line-height: 1.7; letter-spacing: -.01em; color: rgba(255,255,255,.55); max-width: 46ch; }
    @media (min-width: 1024px) {
      .lx-item { grid-template-columns: minmax(0, 200px) minmax(0, 1fr); align-items: start; }
      .lx-head { padding-top: 1px; }
    }

    /* The photo bleeds off the right edge, floor to ceiling, and dissolves into
       the ink so there is no hard seam against the text column. */
    .lx-photo-fade { -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,.55) 12%, #000 34%); mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,.55) 12%, #000 34%); }
  </style>

  <!-- ============ 2 · HERO ============ -->
  <!-- Section 1 (visible breadcrumbs) is deliberately not rendered — the trail
       still ships as BreadcrumbList JSON-LD above. -->
  <!-- UI: service-page #hero, verbatim (video, proof badges, stat count-up). -->
  <section id="hero" class="relative min-h-screen lg:h-screen overflow-hidden text-white bg-black" data-nav-theme="dark">
    <img src={heroPhoto} alt="" aria-hidden="true" fetchpriority="high" decoding="async" class="absolute inset-0 w-full h-full object-cover md:hidden" />
    <video class="absolute inset-0 w-full h-full object-cover hidden md:block" data-desktop-only muted loop playsinline preload="none" data-webm="/assets/video/hero-0715.webm" data-mp4="/assets/video/hero-0715.mp4" poster="/assets/images/hero-poster-0715.webp" aria-hidden="true" tabindex="-1"></video>
    <div class="absolute inset-0 bg-black/65"></div>

    <div class="relative z-20 h-full min-h-screen w-full mx-auto max-w-[1920px] px-5 sm:px-10 lg:px-[60px] flex flex-col justify-center sm:justify-end pt-[158px] pb-[88px] sm:py-0 sm:pb-24 lg:pb-[90px] sm:pt-[130px] gap-5 lg:gap-6">
      <TrustPill />

      <div class="font-semibold capitalize leading-[1.06] sm:leading-[1.03] tracking-[-0.04em] sm:tracking-[-0.03em] text-[clamp(1.95rem,8.6vw,3rem)] sm:text-[clamp(3rem,6.8vw,6.05rem)] text-center">
        <h1>
          <span>{d.heroCity}</span><br />
          <span class="text-brand block">{d.heroService}</span>
        </h1>
        <div class="flex flex-col items-center gap-3 sm:gap-5">
          <span>Installation Experts</span>
          <p class="text-[13.5px] sm:text-[16.5px] font-medium normal-case leading-[1.4] tracking-[-0.02em] text-[#f0f0f0] max-w-[540px]">{d.heroSubhead}</p>
        </div>
      </div>

      <div class="flex flex-col items-center gap-8">
        <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-center sm:justify-center gap-3 sm:gap-4 w-full sm:w-auto">
          <a href="#estimate" class="btn js-open-estimate w-full sm:w-auto text-center bg-brand hover:bg-[#c23c18] rounded-full px-8 py-3.5 text-[18px] font-semibold capitalize text-white">Free Estimate</a>
          <a href={site.phoneHref} class="btn w-full sm:w-auto text-center border border-[#a3a3a3] hover:border-white hover:bg-white/10 rounded-full px-8 py-3.5 text-[18px] font-semibold capitalize text-[#f2f2f2]">{site.phone}</a>
        </div>
        <!-- Bottom row: stats on the left, the marks we build to on the right.
             Capped narrower than the hero's 1920 grid and centred, so on a wide
             screen the two ends pull in off the edges. -->
        <div class="w-full flex flex-col gap-8 lg:mt-[120px] lg:mx-auto lg:max-w-[1180px] lg:flex-row lg:items-end lg:justify-between">
          <div class="grid grid-cols-3 gap-x-3 sm:gap-x-8 gap-y-5 lg:flex lg:flex-wrap lg:justify-start">
            {d.stats.map((s) => (
              <div class="flex flex-col items-start">
                <span class="font-normal text-[2.05rem] sm:text-[clamp(2rem,3vw,2.8rem)] leading-[1.085] tracking-[-0.04em]"><span class="stat-num" data-count={s.count}>{s.count}</span>{s.suffix}</span>
                <span class="font-poppins text-[13px] sm:text-[14px] font-medium capitalize text-[#e9e9e9] tracking-[-0.03em] leading-[1.25]">
                  {/* Labels wrap on their own now — "|" in the data is just a word break. */}
                  {s.label.split('|').map((part) => part.trim()).join(' ')}
                </span>
              </div>
            ))}
          </div>
          <!-- Credential marks: each logo carries its own claim, so the row states
               what the badges mean. Reversed (white-on-transparent) marks, so they
               read on the dark hero; images are decorative — the label names them. -->
          <div class="hidden sm:flex items-center gap-5 sm:gap-7 lg:mr-9 lg:translate-y-[10px]">
            <div class="flex items-center gap-2.5 sm:gap-3.5">
              <img loading="lazy" decoding="async" src="/assets/images/brand/schluter-white.webp" width="408" height="240" alt="" class="block h-9 sm:h-11 w-auto opacity-90" />
              <p class="shrink-0 font-poppins text-[11px] sm:text-[14px] font-medium text-[#e9e9e9] tracking-[-0.03em] leading-[1.25]">Schluter®<br />Certified</p>
            </div>
            <span class="h-8 sm:h-10 w-px shrink-0 bg-white/20" aria-hidden="true"></span>
            <div class="flex items-center gap-2.5 sm:gap-3.5">
              <img loading="lazy" decoding="async" src="/assets/images/brand/ntca-white.webp" width="240" height="240" alt="" class="block h-14 sm:h-[66px] w-auto opacity-90" />
              <p class="shrink-0 font-poppins text-[11px] sm:text-[14px] font-medium text-[#e9e9e9] tracking-[-0.03em] leading-[1.25]">NTCA<br />Member</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 3 · TRUST, 3 CARDS ============ -->
  <!-- UI: home-page #benefits card grid, verbatim — bordered container on
       #faf9f8, 88px outline-circle icon, title pinned below it. -->
  <section id="trust" class="bg-white" data-nav-theme="light">
    <div class="mx-auto max-w-[1920px] px-5 sm:px-10 lg:px-[60px] pt-16 lg:pt-20 pb-20 lg:pb-24">
      <div class="grid md:grid-cols-3 border border-black/10 bg-[#faf9f8]">
        {d.trust.map((c, i) => (
          <div class:list={[
            'flex flex-col p-6 sm:p-8 lg:p-9',
            i > 0 && 'border-t md:border-t-0 md:border-l border-black/10',
          ]}>
            <span class="grid place-items-center h-12 w-12 md:h-16 md:w-16 rounded-full border border-brand/40 text-brand">
              <svg class="w-5 h-5 md:w-7 md:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[c.icon]} />
            </span>
            <div class="mt-6 md:mt-14">
              <h2 class="text-[1.25rem] md:text-[clamp(1.35rem,1.55vw,1.6rem)] font-semibold tracking-[-0.03em]">{c.title}</h2>
              <p class="mt-2.5 text-[14px] leading-[1.6] text-graycard max-w-[340px]">{c.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 4 · WHAT'S INCLUDED ============ -->
  <!-- UI: service-page #included tile grid + .feat-check row for the permit line. -->
  <section id="included" class="bg-white" data-nav-theme="light">
    <div class="mx-auto max-w-[1920px] px-5 sm:px-10 lg:px-[60px] pt-16 lg:pt-20 pb-28 lg:pb-[150px]">
      <h2 class="font-semibold capitalize leading-[1.05] tracking-[-0.04em] text-[clamp(2.5rem,4vw,3.75rem)]">{d.includedTitle}</h2>
      <p class="mt-5 text-[13.5px] sm:text-[15px] leading-[1.6] tracking-[-0.01em] text-graydesc max-w-[620px]">{d.includedIntro}</p>

      {/* Card count follows the matching service page: tile/flooring run 3-up,
          showers 4-up. */}
      <div class:list={['mt-12 lg:mt-16 grid gap-3 sm:grid-cols-2', d.included.length === 3 ? 'lg:grid-cols-3' : 'lg:grid-cols-4']}>
        {d.included.map((it) => (
          <article class="svc-tile">
            <div class="svc-figure">
              <img class="svc-img" src={it.image} alt={it.alt} loading="lazy" decoding="async" />
            </div>
            <h3 class="svc-title">{it.title}</h3>
            <p class="svc-desc">{it.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 5 · ★ LOCAL EXPERTISE ============ -->
  <!-- The one section on the page that is unique to this city, so it gets the
       page's only ink band: photo bleeding off the right edge, conditions read
       as a spec sheet rather than a paragraph list. -->
  <section id="local" class="relative bg-[#0f0f0f] text-white overflow-hidden" data-nav-theme="dark">
    <!-- Desktop: full-height bleed. Mobile gets the same photo below the text. -->
    <img
      loading="lazy" decoding="async" src={d.localImage} alt={d.localImageAlt}
      class="lx-photo-fade hidden lg:block absolute right-0 top-0 h-full w-[42%] object-cover" />

    <div class="relative mx-auto max-w-[1920px] px-5 sm:px-10 lg:px-[60px] pt-24 lg:pt-[160px] pb-24 lg:pb-[160px] lg:pr-[calc(42%+40px)]">
      <h2 class="font-semibold leading-[1.08] tracking-[-0.035em] text-[clamp(2rem,3vw,2.9rem)]">
        {/* A " | " in the title is an explicit line break — desktop only, so
            narrow screens still wrap on their own. */}
        {d.localTitle.split('|').map((part, i) => (
          <>{i > 0 && <br class="hidden lg:block" />}{i > 0 ? ' ' : ''}{part.trim()}</>
        ))}
      </h2>

      <div class="local-prose mt-5 max-w-[560px]"><Content /></div>

      <div class="mt-9 lg:mt-12">
        {d.localPoints.map((pt) => (
          <div class="lx-item">
            <h3 class="lx-head">{pt.title}</h3>
            <p class="lx-body">{pt.body}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="lg:hidden -mt-2">
      <img loading="lazy" decoding="async" src={d.localImage} alt={d.localImageAlt}
        class="w-full aspect-[16/11] object-cover" />
    </div>
  </section>

  <!-- ============ 6 · ★ A PROJECT HERE ============ -->
  <!-- UI: full-bleed project photo + the stat strip. -->
  <section id="project" class="bg-[#f6f5f3]" data-nav-theme="light">
    <div class="mx-auto max-w-[1920px] px-5 sm:px-10 lg:px-[60px] pt-24 lg:pt-[140px] pb-10 lg:pb-14">
      <h2 class="font-bold text-ink leading-[1.05] tracking-[-0.03em] text-[clamp(2.4rem,5vw,4rem)]">
        A recent project in {d.project.neighborhood}
      </h2>
      <p class="mt-5 text-[13.5px] sm:text-[15.5px] leading-[1.75] text-graydesc max-w-[680px]">{d.project.story}</p>
    </div>

    <figure class="proj-photo">
      <img loading="lazy" decoding="async" src={d.project.image} alt={d.project.imageAlt} class="w-full h-full object-cover" />
    </figure>

    <div class="mx-auto max-w-[1920px] px-5 sm:px-10 lg:px-[60px] pb-20 lg:pb-[100px]">
      <!-- Four scannable facts as a stat strip. -->
      <dl class="mt-12 lg:mt-16 grid grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-9">
        <div class="spec-stat">
          <dt class="spec-label">Neighborhood</dt>
          <dd class="spec-value">{d.project.neighborhood}</dd>
        </div>
        <div class="spec-stat">
          <dt class="spec-label">Year</dt>
          <dd class="spec-value">{d.project.year}</dd>
        </div>
        <div class="spec-stat">
          <dt class="spec-label">Timeline</dt>
          <dd class="spec-value">{d.project.timeline}</dd>
        </div>
        <div class="spec-stat">
          <dt class="spec-label">Budget</dt>
          <dd class="spec-value">{d.project.budget}</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ============ 7 · REVIEWS ============ -->
  <!-- UI: shared ReviewsSection, with this city + service's own reviews. -->
  <ReviewsSection reviews={cityReviews} tone="white" pad="pt-20 lg:pt-[110px] pb-8 lg:pb-12" />

  <!-- ============ 8 · PROCESS ============ -->
  <!-- UI: service-page #process sticky steps + parallax photos. -->
  <section id="process" class="bg-white" data-nav-theme="light">
    <div class="mx-auto max-w-[1920px] px-5 sm:px-10 lg:px-[60px] pt-12 lg:pt-16">
      <h2 class="font-semibold capitalize text-ink leading-[1.04] tracking-[-0.04em] text-[clamp(2.9rem,7.5vw,5.75rem)]">Our Process</h2>
    </div>
    <div class="bg-[#faf9f8] mt-10 lg:mt-14 pb-20 lg:pb-[100px]">
      <div class="mx-auto max-w-[1920px] px-5 sm:px-10 lg:px-[60px]">
        <div class="border-b border-black/10">
          {d.process.map((s, i) => (
            <div class:list={['process-step grid grid-cols-1 md:grid-cols-[1.4fr_auto_1.3fr] gap-x-8 gap-y-4 md:gap-y-5 md:items-center py-8', i > 0 && 'border-t border-black/10']}>
              <div class="px-frame w-full sm:w-[420px] aspect-[16/11]">
                <img loading="lazy" decoding="async" src={s.image} alt={s.title} class:list={['px-img', i === 0 && 'px-fit']} />
              </div>
              <span class="font-light leading-none tracking-[-0.02em] text-[clamp(2.75rem,5.5vw,6rem)] text-ink justify-self-start">{i + 1}</span>
              <div class="md:col-span-1 md:pl-10 lg:pl-14 -mt-1 md:mt-0">
                <h3 class="text-[clamp(1.45rem,2.1vw,1.9rem)] font-semibold tracking-[-0.025em]">{s.title}</h3>
                <p class="mt-2 text-[14px] leading-[1.6] text-graycard max-w-[560px]">{s.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 9 · PRICING ============ -->
  <!-- Three tier cards; the `featured` one lifts on a warm gray fill. -->
  <section id="pricing" class="bg-white" data-nav-theme="light">
    <div class="mx-auto max-w-[1400px] px-5 sm:px-10 lg:px-[60px] py-20 lg:py-[110px]">
      <div class="mx-auto max-w-[760px] text-center">
        <h2 class="font-semibold leading-[1.1] tracking-[-0.035em] text-[clamp(2rem,3.2vw,3rem)]">{d.pricingTitle}</h2>
        <p class="mt-5 text-[13.5px] sm:text-[15.5px] leading-[1.7] tracking-[-0.01em] text-graydesc">{d.pricingIntro}</p>
      </div>

      <div class="mt-12 lg:mt-16 grid gap-3 lg:grid-cols-3 items-stretch">
        {d.pricing.map((tier) => (
          <article class:list={['tier', tier.featured && 'tier-featured']}>
            <p class="tier-price">{tier.headline}</p>
            <p class="tier-eyebrow">{tier.eyebrow}</p>
            <div class="tier-rule" aria-hidden="true"></div>
            <ul class="tier-list">
              {tier.features.map((f) => (
                <li class="tier-item">
                  <svg class="tier-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5L20 7"/></svg>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- ============ 10 · SERVICE AREA ============ -->
  <!-- UI: service-page #service-area + the shared ServiceAreaMap component. -->
  <section id="service-area" class="relative bg-black text-white overflow-hidden" data-nav-theme="dark">
    <div class="mx-auto max-w-[1920px] px-5 sm:px-10 lg:px-[60px] py-16 lg:py-[170px] lg:min-h-[720px] flex items-center">
      <div class="lg:max-w-[44%]">
        <h2 class="font-bold leading-[1.02] tracking-[-0.025em] text-[clamp(2.5rem,5.5vw,4.75rem)]">{d.areaTitle}</h2>
        <p class="mt-6 text-[13.5px] sm:text-[15px] leading-[1.6] tracking-[-0.01em] text-white/55 max-w-[520px]">{d.areaBody}</p>
      </div>
    </div>
    <ServiceAreaMap service={service.id} />
  </section>

  <!-- ============ 11 · FAQ ============ -->
  <!-- UI: service-page #faqs accordion. -->
  <section id="faqs" class="bg-[#faf9f8]" data-nav-theme="light">
    <div class="mx-auto max-w-[1920px] px-5 sm:px-10 lg:px-[60px] py-20 lg:py-[100px]">
      <h2 class="font-bold capitalize leading-[1.02] tracking-[-0.03em] text-[clamp(2.1rem,5vw,4rem)]">{d.heroCity} {service.data.shortName.toLowerCase()} questions</h2>
      <p class="mt-5 text-[13.5px] sm:text-[15px] leading-[1.6] tracking-[-0.01em] text-graydesc max-w-[600px]">Permits, associations, cost, living in the house, and how long it takes. Still have a question? Give us a call.</p>
      <div id="faqList" class="mt-12 lg:mt-16">
        {d.faqs.map((f) => (
          <div class="faq-item">
            <button class="faq-q" aria-expanded="true">
              <span class="text-[clamp(1.05rem,1.5vw,1.35rem)] font-semibold tracking-[-0.01em] pr-4">{f.q}</span>
              <span class="faq-ico" aria-hidden="true"></span>
            </button>
            <div class="faq-a"><div class="faq-a-inner"><p class="text-[13.5px] sm:text-[15px] leading-[1.7] text-graydesc max-w-[860px]">{f.a}</p></div></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 12 · CTA + LINKS ============ -->
  <!-- UI: service-page #estimate step-1 block + .svc-other link cards. -->
  <section id="estimate" class="bg-black text-white border-t border-white/10" data-nav-theme="dark">
    {SHOW_RELATED && d.related.length > 0 && (
      <div class="mx-auto max-w-[1920px] px-5 sm:px-10 lg:px-[60px] pt-20 lg:pt-[100px]">
        <h2 class="font-semibold capitalize leading-[1.05] tracking-[-0.04em] text-[clamp(2.1rem,3.4vw,3.25rem)]">Keep looking</h2>
        <div class="mt-10 grid gap-3 sm:grid-cols-3">
          {d.related.map((r) => (
            <a href={r.href} class="svc-other btn block border border-white/15 p-7 lg:p-9">
              <span class="block text-[19px] font-semibold tracking-[-0.02em] leading-[1.25]">{r.label}</span>
              <span class="mt-3 block text-[14px] leading-[1.6] text-white/55">{r.blurb}</span>
              <span class="mt-6 inline-flex items-center gap-2 text-[14px] font-semibold text-brand">
                View
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Step 1 (inline). Choosing a project + Next opens the full-screen wizard overlay. -->
    <div class="px-5 sm:px-10 lg:px-[60px] py-16 lg:py-24 flex items-center justify-center">
      <div class="w-full max-w-[440px]">
        <h3 class="text-center font-bold capitalize leading-[1.1] tracking-[-0.025em] text-[clamp(2.4rem,4vw,3.75rem)]">Request your<br />free estimate</h3>
        <p class="mt-6 text-center text-[13.5px] sm:text-[15px] font-semibold text-white/85">What project are you interested in?</p>

        <div class="mt-5 space-y-4" id="step1Options">
          <label class="fopt"><input type="checkbox" name="s1project" value="Custom Showers" /><span class="pill-label">Custom Showers</span><span class="fradio" aria-hidden="true"></span></label>
          <label class="fopt"><input type="checkbox" name="s1project" value="Tile & Natural Stone" /><span class="pill-label">Tile &amp; Natural Stone</span><span class="fradio" aria-hidden="true"></span></label>
          <label class="fopt"><input type="checkbox" name="s1project" value="Flooring" /><span class="pill-label">Flooring</span><span class="fradio" aria-hidden="true"></span></label>
          <label class="fopt" id="s1OtherPill"><input type="checkbox" name="s1project" value="Other" id="s1OtherRadio" /><span class="pill-label">Other</span><input type="text" id="s1OtherInput" class="other-inline-input" placeholder="Please describe your project…" autocomplete="off" aria-label="Describe your project" /><span class="fradio" aria-hidden="true"></span></label>
        </div>

        <p class="wiz-error text-center" id="step1Error">Please select a project to continue.</p>

        <div class="mt-8">
          <button type="button" class="btn w-full rounded-full bg-brand hover:bg-[#e03f1c] py-4 text-[15px] font-semibold capitalize text-white" id="step1Next">Next</button>
        </div>
        <p class="mt-5 text-center text-[14px] text-white/55">Questions? Call: <a href={site.phoneHref} class="text-brand hover:underline">{site.phone}</a></p>
      </div>
    </div>
  </section>

  <script is:inline>
    // Count-up animation for hero stats
    (function () {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const nums = document.querySelectorAll('.stat-num');
      const fmt = (v, dec) => (dec ? v.toFixed(dec) : String(Math.round(v)));
      const decOf = (el) => (el.dataset.count.split('.')[1] || '').length;
      const runCount = (el) => {
        const target = parseFloat(el.dataset.count);
        const dec = decOf(el);
        const duration = 1500; let st = null;
        const tick = (now) => { if (st === null) st = now; const p = Math.min((now - st) / duration, 1); const e = 1 - Math.pow(1 - p, 3); el.textContent = fmt(target * e, dec); if (p < 1) requestAnimationFrame(tick); else el.textContent = fmt(target, dec); };
        requestAnimationFrame(tick);
      };
      if (reduceMotion || !('IntersectionObserver' in window)) {
        nums.forEach((el) => { el.textContent = fmt(parseFloat(el.dataset.count), decOf(el)); });
      } else {
        nums.forEach((el) => { el.textContent = fmt(0, decOf(el)); });
        const io = new IntersectionObserver((entries) => { entries.forEach((e) => { if (e.isIntersecting) { runCount(e.target); io.unobserve(e.target); } }); }, { threshold: 0.6 });
        nums.forEach((el) => io.observe(el));
      }
    })();

    // FAQ accordion — single-open; content stays visible if JS is unavailable
    (function () {
      const faqList = document.getElementById('faqList');
      if (!faqList) return;
      faqList.classList.add('js-faq');
      const fitems = [...faqList.querySelectorAll('.faq-item')].map((item) => ({ q: item.querySelector('.faq-q'), a: item.querySelector('.faq-a') }));
      const collapse = (it) => { it.q.setAttribute('aria-expanded', 'false'); it.a.style.height = '0px'; };
      const expand = (it) => { it.q.setAttribute('aria-expanded', 'true'); it.a.style.height = it.a.scrollHeight + 'px'; };
      fitems.forEach((it) => { collapse(it); it.q.addEventListener('click', () => { const isOpen = it.q.getAttribute('aria-expanded') === 'true'; fitems.forEach(collapse); if (!isOpen) expand(it); }); });
      window.addEventListener('resize', () => { const open = fitems.find((it) => it.q.getAttribute('aria-expanded') === 'true'); if (open) open.a.style.height = open.a.scrollHeight + 'px'; }, { passive: true });
    })();

    // Parallax process photos
    (function () {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const pxImgs = [...document.querySelectorAll('.px-img:not(.px-fit)')];
      if (!pxImgs.length || reduceMotion) return;
      let pxTicking = false;
      const renderParallax = () => {
        const vh = window.innerHeight;
        pxImgs.forEach((img) => {
          const frame = img.parentElement;
          const r = frame.getBoundingClientRect();
          if (r.bottom < 0 || r.top > vh) return;
          const progress = (r.top + r.height / 2 - vh / 2) / (vh / 2 + r.height / 2);
          const shift = frame.offsetHeight * 0.20;
          img.style.transform = `translateY(${(progress * shift).toFixed(1)}px)`;
        });
        pxTicking = false;
      };
      const onPxScroll = () => { if (!pxTicking) { pxTicking = true; requestAnimationFrame(renderParallax); } };
      window.addEventListener('scroll', onPxScroll, { passive: true });
      window.addEventListener('resize', onPxScroll, { passive: true });
      renderParallax();
    })();

  </script>
</BaseLayout>
