  <!-- ============ 9 · PRICING ============ -->
  <!-- Three tier cards; the `featured` one lifts on a warm gray fill. -->
  <section id="pricing" class="bg-white" data-nav-theme="light">
    <div class="mx-auto max-w-[1400px] px-5 sm:px-10 lg:px-[60px] py-20 lg:py-[110px]">
      <div class="mx-auto max-w-[760px] text-center">
        <h2 class="font-semibold leading-[1.1] tracking-[-0.035em] text-[clamp(2rem,3.2vw,3rem)]">{d.pricingTitle}</h2>
        <p class="mt-5 text-[15.5px] leading-[1.7] tracking-[-0.01em] text-graydesc">{d.pricingIntro}</p>
      </div>

      <div class="mt-12 lg:mt-16 grid gap-3 lg:grid-cols-3 items-stretch">
        {d.pricing.map((tier) => (
          <article class:list={['tier', tier.featured && 'tier-featured']}>
            <p class="tier-price">{tier.headline}</p>
            <p class="tier-eyebrow">{tier.eyebrow}</p>
            <div class="tier-rule" aria-hidden="true"></div>
            <ul class="tier-list">
              {tier.features.map((f) => (
                <li class="tier-item">
                  <svg class="tier-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5L20 7"/></svg>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- ============ 10 · SERVICE AREA ============ -->
  <!-- UI: service-page #service-area + the shared ServiceAreaMap component. -->
  <section id="service-area" class="relative bg-black text-white overflow-hidden" data-nav-theme="dark">
    <div class="mx-auto max-w-[1920px] px-5 sm:px-10 lg:px-[60px] py-20 lg:py-[260px] lg:min-h-[1040px] flex items-center">
      <div class="lg:max-w-[44%]">
        <h2 class="font-bold leading-[1.02] tracking-[-0.025em] text-[clamp(2.5rem,5.5vw,4.75rem)]">{d.areaTitle}</h2>
        <p class="mt-6 text-[15px] leading-[1.6] tracking-[-0.01em] text-white/55 max-w-[520px]">{d.areaBody}</p>
      </div>
    </div>
    <ServiceAreaMap service={service.id} />
  </section>

  <!-- ============ 11 · FAQ ============ -->
  <!-- UI: service-page #faqs accordion. -->
  <section id="faqs" class="bg-[#faf9f8]" data-nav-theme="light">
    <div class="mx-auto max-w-[1920px] px-5 sm:px-10 lg:px-[60px] py-20 lg:py-[100px]">
      <h2 class="font-bold capitalize leading-[1.02] tracking-[-0.03em] text-[clamp(2.1rem,5vw,4rem)]">{d.heroCity} {service.data.shortName.toLowerCase()} questions</h2>
      <p class="mt-5 text-[15px] leading-[1.6] tracking-[-0.01em] text-graydesc max-w-[600px]">Permits, associations, cost, living in the house, and how long it takes. Still have a question? Give us a call.</p>
      <div id="faqList" class="mt-12 lg:mt-16">
        {d.faqs.map((f) => (
          <div class="faq-item">
            <button class="faq-q" aria-expanded="true">
              <span class="text-[clamp(1.05rem,1.5vw,1.35rem)] font-semibold tracking-[-0.01em] pr-4">{f.q}</span>
              <span class="faq-ico" aria-hidden="true"></span>
            </button>
            <div class="faq-a"><div class="faq-a-inner"><p class="text-[15px] leading-[1.7] text-graydesc max-w-[860px]">{f.a}</p></div></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 12 · CTA + LINKS ============ -->
  <!-- UI: service-page #estimate step-1 block + .svc-other link cards. -->
  <section id="estimate" class="bg-black text-white border-t border-white/10" data-nav-theme="dark">
    {SHOW_RELATED && d.related.length > 0 && (
      <div class="mx-auto max-w-[1920px] px-5 sm:px-10 lg:px-[60px] pt-20 lg:pt-[100px]">
        <h2 class="font-semibold capitalize leading-[1.05] tracking-[-0.04em] text-[clamp(2.1rem,3.4vw,3.25rem)]">Keep looking</h2>
        <div class="mt-10 grid gap-3 sm:grid-cols-3">
          {d.related.map((r) => (
            <a href={r.href} class="svc-other btn block border border-white/15 p-7 lg:p-9">
              <span class="block text-[19px] font-semibold tracking-[-0.02em] leading-[1.25]">{r.label}</span>
              <span class="mt-3 block text-[14px] leading-[1.6] text-white/55">{r.blurb}</span>
              <span class="mt-6 inline-flex items-center gap-2 text-[14px] font-semibold text-brand">
                View
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Step 1 (inline). Choosing a project + Next opens the full-screen wizard overlay. -->
    <div class="px-5 sm:px-10 lg:px-[60px] py-16 lg:py-24 flex items-center justify-center">
      <div class="w-full max-w-[440px]">
        <h3 class="text-center font-bold capitalize leading-[1.1] tracking-[-0.025em] text-[clamp(2.4rem,4vw,3.75rem)]">Request your<br />free estimate</h3>
        <p class="mt-6 text-center text-[15px] font-semibold text-white/85">What project are you interested in?</p>

        <div class="mt-5 space-y-4" id="step1Options">
          <label class="fopt"><input type="checkbox" name="s1project" value="Custom Showers" /><span class="pill-label">Custom Showers</span><span class="fradio" aria-hidden="true"></span></label>
          <label class="fopt"><input type="checkbox" name="s1project" value="Tile & Natural Stone" /><span class="pill-label">Tile &amp; Natural Stone</span><span class="fradio" aria-hidden="true"></span></label>
          <label class="fopt"><input type="checkbox" name="s1project" value="Hard Surface Flooring" /><span class="pill-label">Hard Surface Flooring</span><span class="fradio" aria-hidden="true"></span></label>
          <label class="fopt" id="s1OtherPill"><input type="checkbox" name="s1project" value="Other" id="s1OtherRadio" /><span class="pill-label">Other</span><input type="text" id="s1OtherInput" class="other-inline-input" placeholder="Please describe your project…" autocomplete="off" aria-label="Describe your project" /><span class="fradio" aria-hidden="true"></span></label>
        </div>

        <p class="wiz-error text-center" id="step1Error">Please select a project to continue.</p>

        <div class="mt-8">
          <button type="button" class="btn w-full rounded-full bg-brand hover:bg-[#e03f1c] py-4 text-[15px] font-semibold capitalize text-white" id="step1Next">Next</button>
        </div>
        <p class="mt-5 text-center text-[14px] text-white/55">Questions? Call: <a href={site.phoneHref} class="text-brand hover:underline">{site.phone}</a></p>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ reviews: d.reviews }}>
    // Count-up animation for hero stats
    (function () {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const nums = document.querySelectorAll('.stat-num');
      const fmt = (v, dec) => (dec ? v.toFixed(dec) : String(Math.round(v)));
      const decOf = (el) => (el.dataset.count.split('.')[1] || '').length;
      const runCount = (el) => {
        const target = parseFloat(el.dataset.count);
        const dec = decOf(el);
        const duration = 1500; let st = null;
        const tick = (now) => { if (st === null) st = now; const p = Math.min((now - st) / duration, 1); const e = 1 - Math.pow(1 - p, 3); el.textContent = fmt(target * e, dec); if (p < 1) requestAnimationFrame(tick); else el.textContent = fmt(target, dec); };
        requestAnimationFrame(tick);
      };
      if (reduceMotion || !('IntersectionObserver' in window)) {
        nums.forEach((el) => { el.textContent = fmt(parseFloat(el.dataset.count), decOf(el)); });
      } else {
        nums.forEach((el) => { el.textContent = fmt(0, decOf(el)); });
        const io = new IntersectionObserver((entries) => { entries.forEach((e) => { if (e.isIntersecting) { runCount(e.target); io.unobserve(e.target); } }); }, { threshold: 0.6 });
        nums.forEach((el) => io.observe(el));
      }
    })();

    // Reviews carousel — same controller as the service pages, city data injected.
    (function () {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revQuote = document.getElementById('revQuote');
      if (!revQuote || !reviews || reviews.length < 2) return;
      const revName = document.getElementById('revName');
      const revRole = document.getElementById('revRole');
      const revImg = document.getElementById('revImg');
      const revAvatar = document.getElementById('revAvatar');
      const fades = [document.getElementById('revMeta'), revQuote.closest('.rev-fade'), revImg.closest('.rev-fade')];
      let i = 0;
      const dotsWrap = document.getElementById('revDots');
      let dots = [];
      const syncDots = () => dots.forEach((el, n) => {
        el.classList.toggle('is-active', n === i);
        el.setAttribute('aria-current', n === i ? 'true' : 'false');
      });
      const paint = () => {
        const r = reviews[i];
        revName.textContent = r.name;
        revRole.textContent = r.neighborhood;
        revRole.classList.toggle('hidden', !r.neighborhood);
        revQuote.textContent = r.quote;
        revImg.src = r.image;
        revAvatar.src = r.avatar;
        syncDots();
      };
      const quoteCol = revQuote.closest('.rev-fade').parentElement;
      const lockHeight = () => {
        const current = reviews[i].quote;
        quoteCol.style.minHeight = '';
        let max = 0;
        reviews.forEach((r) => { revQuote.textContent = r.quote; max = Math.max(max, quoteCol.offsetHeight); });
        revQuote.textContent = current;
        quoteCol.style.minHeight = max + 'px';
      };
      let animating = false;
      const go = (dir) => {
        if (animating) return;
        i = (i + dir + reviews.length) % reviews.length;
        if (reduceMotion) { paint(); return; }
        animating = true;
        const outX = dir > 0 ? -36 : 36;
        const inX = dir > 0 ? 36 : -36;
        fades.forEach((el) => { el.style.opacity = '0'; el.style.transform = `translateX(${outX}px)`; });
        setTimeout(() => {
          paint();
          fades.forEach((el) => { el.style.transition = 'none'; el.style.transform = `translateX(${inX}px)`; });
          void document.body.offsetWidth;
          requestAnimationFrame(() => {
            fades.forEach((el) => { el.style.transition = ''; el.style.opacity = '1'; el.style.transform = 'translateX(0)'; });
            setTimeout(() => { animating = false; }, 450);
          });
        }, 350);
      };
      let timer = null;
      const start = () => { timer = setInterval(() => go(1), 5000); };
      const reset = () => { clearInterval(timer); start(); };
      document.getElementById('revPrev').addEventListener('click', () => { go(-1); reset(); });
      document.getElementById('revNext').addEventListener('click', () => { go(1); reset(); });
      const reviewsSection = document.getElementById('reviews');
      reviewsSection.addEventListener('mouseenter', () => clearInterval(timer));
      reviewsSection.addEventListener('mouseleave', start);
      let touchX = null, touchY = null;
      reviewsSection.addEventListener('touchstart', (e) => {
        touchX = e.changedTouches[0].clientX;
        touchY = e.changedTouches[0].clientY;
      }, { passive: true });
      reviewsSection.addEventListener('touchend', (e) => {
        if (touchX === null) return;
        const dx = e.changedTouches[0].clientX - touchX;
        const dy = e.changedTouches[0].clientY - touchY;
        touchX = touchY = null;
        if (Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(dy)) return;
        go(dx < 0 ? 1 : -1);
        reset();
      }, { passive: true });
      lockHeight();
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(lockHeight);
      let revResizeT = null;
      window.addEventListener('resize', () => { clearTimeout(revResizeT); revResizeT = setTimeout(lockHeight, 150); }, { passive: true });
      if (dotsWrap) {
        dots = reviews.map((r, n) => {
          const el = document.createElement('button');
          el.type = 'button';
          el.className = 'rev-dot';
          el.setAttribute('role', 'tab');
          el.setAttribute('aria-label', 'Show review ' + (n + 1) + ' of ' + reviews.length);
          el.addEventListener('click', () => { if (n !== i) { go(n - i); reset(); } });
          dotsWrap.appendChild(el);
          return el;
        });
        syncDots();
      }
      start();
    })();

    // FAQ accordion — single-open; content stays visible if JS is unavailable
    (function () {
      const faqList = document.getElementById('faqList');
      if (!faqList) return;
      faqList.classList.add('js-faq');
      const fitems = [...faqList.querySelectorAll('.faq-item')].map((item) => ({ q: item.querySelector('.faq-q'), a: item.querySelector('.faq-a') }));
      const collapse = (it) => { it.q.setAttribute('aria-expanded', 'false'); it.a.style.height = '0px'; };
      const expand = (it) => { it.q.setAttribute('aria-expanded', 'true'); it.a.style.height = it.a.scrollHeight + 'px'; };
      fitems.forEach((it) => { collapse(it); it.q.addEventListener('click', () => { const isOpen = it.q.getAttribute('aria-expanded') === 'true'; fitems.forEach(collapse); if (!isOpen) expand(it); }); });
      window.addEventListener('resize', () => { const open = fitems.find((it) => it.q.getAttribute('aria-expanded') === 'true'); if (open) open.a.style.height = open.a.scrollHeight + 'px'; }, { passive: true });
    })();

    // Parallax process photos
    (function () {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const pxImgs = [...document.querySelectorAll('.px-img')];
      if (!pxImgs.length || reduceMotion) return;
      let pxTicking = false;
      const renderParallax = () => {
        const vh = window.innerHeight;
        pxImgs.forEach((img) => {
          const frame = img.parentElement;
          const r = frame.getBoundingClientRect();
          if (r.bottom < 0 || r.top > vh) return;
          const progress = (r.top + r.height / 2 - vh / 2) / (vh / 2 + r.height / 2);
          const shift = frame.offsetHeight * 0.20;
          img.style.transform = `translateY(${(progress * shift).toFixed(1)}px)`;
        });
        pxTicking = false;
      };
      const onPxScroll = () => { if (!pxTicking) { pxTicking = true; requestAnimationFrame(renderParallax); } };
      window.addEventListener('scroll', onPxScroll, { passive: true });
      window.addEventListener('resize', onPxScroll, { passive: true });
      renderParallax();
    })();

  </script>
</BaseLayout>
