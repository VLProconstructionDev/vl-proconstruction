---
/**
 * City × service page shell — /locations/[city]/[service].
 *
 * Driven entirely by one `cityServices` entry (plus the matching `locations` /
 * `services` entries for names). Every section's UI is lifted from an existing
 * live page — see the comment above each one for where it came from — so these
 * pages stay visually identical to the rest of the site.
 */
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ServiceAreaMap from '@components/ServiceAreaMap.astro';
import { site } from '@/lib/site';
import { serviceSchema, breadcrumbSchema } from '@/lib/schema';
import { cityServicePath } from '@/lib/urls';

interface Props {
  entry: CollectionEntry<'cityServices'>;
  location: CollectionEntry<'locations'>;
  service: CollectionEntry<'services'>;
}

const { entry, location, service } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

const cityState = `${location.data.name}, ${location.data.state}`;
const path = cityServicePath(location, service.id);

const schema = [
  serviceSchema({
    name: `${service.data.title} in ${cityState}`,
    description: d.seoDescription,
    slug: service.id,
    areaServed: cityState,
    url: path,
  }),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Services', url: '/services' },
    { name: service.data.shortName, url: `/services/${service.id}` },
    { name: location.data.name, url: path },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

/** Trust-card icons — same 24px stroke set used on the service pages. */
const ICONS = {
  check: '<path d="M20 6 9 17l-5-5"/>',
  badge:
    '<path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M12 15.6c-1.3-1-3-2-3-3.4 0-1.4 1.9-2.4 3-1 1.1-1.4 3-.4 3 1 0 1.4-1.7 2.4-3 3.4z"/>',
  crew: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.2 1.9"/>',
  map: '<path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11z"/><circle cx="12" cy="10" r="2.6"/>',
  shield: '<path d="M12 3l7.5 3v5.5c0 4.6-3.1 8.3-7.5 9.5-4.4-1.2-7.5-4.9-7.5-9.5V6z"/><path d="m9 12 2.2 2.2L15.5 10"/>',
} as const;

/**
 * The "Keep looking" cross-links at the foot of the page are parked for now —
 * flip to true to bring the block back. The `related` data stays in each
 * city-services file, so nothing has to be rewritten.
 */
const SHOW_RELATED = false;
---

<BaseLayout
  title={d.seoTitle ?? `${service.data.shortName} in ${cityState} — ${site.name}`}
  description={d.seoDescription}
  canonical={path}
  schema={schema}
  navTheme="dark"
>
  <style is:global>
    /* ---- lifted from the service pages ---- */
    .svc-other { transition: border-color .2s, background-color .2s, transform .2s cubic-bezier(.22,1,.36,1); }
    .svc-other:hover { border-color: rgba(245,75,37,.5); background: rgba(255,255,255,.08); transform: translateY(-2px); }
    .svc-other:focus-visible { outline: 2px solid #f54b25; outline-offset: 3px; }

    .svc-tile { display: flex; flex-direction: column; }
    .svc-figure { position: relative; overflow: hidden; aspect-ratio: 4 / 5; background: #141414; }
    .svc-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .svc-title { margin-top: 18px; color: #1e1e1e; font-weight: 600; line-height: 1.15; letter-spacing: -.028em; font-size: clamp(1.2rem, 1.45vw, 1.55rem); }
    .svc-desc { margin-top: 10px; color: #4e4e4e; font-size: 12px; line-height: 1.5; max-width: 42ch; }

    /* ----- FAQ accordion ----- */
    .faq-item { border-bottom: 1px solid rgba(0,0,0,.1); }
    .faq-item:first-child { border-top: 1px solid rgba(0,0,0,.1); }
    .faq-q { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 28px; text-align: left; padding: 26px 0; cursor: pointer; color: #1e1e1e; }
    .faq-ico { position: relative; flex: none; width: 24px; height: 24px; }
    .faq-ico::before, .faq-ico::after { content: ""; position: absolute; background: #1e1e1e; transition: transform .3s ease, opacity .3s ease; }
    .faq-ico::before { top: 50%; left: 0; right: 0; height: 2px; transform: translateY(-50%); }
    .faq-ico::after { left: 50%; top: 0; bottom: 0; width: 2px; transform: translateX(-50%); }
    .faq-q[aria-expanded="true"] .faq-ico::after { transform: translateX(-50%) scaleY(0); opacity: 0; }
    .faq-q[aria-expanded="true"] .faq-ico::before { background: #f54b25; }
    .faq-a { overflow: hidden; }
    .faq-a-inner { padding-bottom: 26px; }
    .js-faq .faq-a { transition: height .32s cubic-bezier(.4,0,.2,1); }
    @media (prefers-reduced-motion: reduce) { .js-faq .faq-a { transition: none; } }

    /* ----- Reviews ----- */
    .rev-fade { transition: opacity .35s ease, transform .45s cubic-bezier(.22,1,.36,1); will-change: transform, opacity; }
    @media (prefers-reduced-motion: reduce) { .rev-fade { transition: none !important; transform: none !important; } }
    .rev-dot { flex: none; height: 6px; width: 6px; border-radius: 9999px; background: rgba(30,30,30,.2); transition: transform .3s cubic-bezier(.2,.8,.2,1), background-color .25s ease; }
    .rev-dot:hover { background: rgba(30,30,30,.38); }
    .rev-dot:focus-visible { outline: 2px solid #f54b25; outline-offset: 3px; }
    .rev-dot.is-active { background: #f54b25; transform: scale(1.35); }
    @media (prefers-reduced-motion: reduce) { .rev-dot { transition: none; } }

    /* ----- Process steps stick & overlap; parallax photos ----- */
    .px-frame { position: relative; overflow: hidden; }
    .process-step > * { min-width: 0; }
    .px-frame .px-img { position: absolute; left: 0; top: -20%; width: 100%; height: 140%; object-fit: cover; will-change: transform; }
    @media (prefers-reduced-motion: reduce) { .px-frame .px-img { position: static; top: 0; height: 100%; transform: none; } }
    .process-step { position: sticky; background: #faf9f8; }
    .process-step:nth-child(1) { top: 92px; }
    .process-step:nth-child(2) { top: 124px; }
    .process-step:nth-child(3) { top: 156px; }
    .process-step:nth-child(4) { top: 188px; }
    @media (prefers-reduced-motion: reduce) { .process-step { position: static; } }

    /* ----- Project photo — same full-bleed frame the comparison slider used ----- */
    .proj-photo { position: relative; overflow: hidden; background: #111; aspect-ratio: 4 / 3; }
    @media (min-width: 1024px) { .proj-photo { aspect-ratio: 5 / 3; } }

    /* ----- Hairline data rows — same rule weight, padding and brand tint as the
       "VL vs others" table on the service pages; used for the project spec list
       and the pricing table. ----- */
    /* Project facts. Each stat carries its own top rule instead of vertical
       dividers, so the grid can wrap to two columns without a stray border. */
    .spec-label { font-size: 12.5px; font-weight: 600; letter-spacing: .01em; color: rgba(30,30,30,.45); }
    .spec-stat { border-top: 1px solid rgba(0,0,0,.14); padding-top: 18px; }
    .spec-value { margin-top: 10px; font-size: clamp(1.35rem, 1.9vw, 1.85rem); font-weight: 600; line-height: 1.15; letter-spacing: -.035em; color: #1e1e1e; }

    /* ----- Pricing tiers — three cards on Apple's neutral scale: white
       ground, white cards, #ebebed hairlines, #6e6e73 secondary text. The
       middle one is the one we want chosen, so it sits on the #f5f5f7 gray
       one step down from white, with a brand-colored label — the fill is its
       own edge, so it carries no border and no shadow. ----- */
    .tier { display: flex; flex-direction: column; background: #fff; border: 1px solid #ebebed; padding: 34px 30px 38px; }
    .tier-featured { background: #f5f5f7; border-color: transparent; }
    .tier-eyebrow { margin-top: 8px; font-size: 12.5px; font-weight: 600; letter-spacing: .01em; color: #6e6e73; }
    /* The label is the only sell signal on the card, so it carries the brand. */
    .tier-featured .tier-eyebrow { color: #c23c18; }
    .tier-price { font-size: clamp(2.05rem, 2.9vw, 2.85rem); font-weight: 600; line-height: 1.05; letter-spacing: -.04em; color: #1d1d1f; }
    .tier-rule { margin: 26px 0 24px; height: 1px; background: #d2d2d7; }
    .tier-list { display: grid; gap: 14px; }
    .tier-item { display: flex; align-items: flex-start; gap: 12px; font-size: 14.5px; line-height: 1.5; letter-spacing: -.01em; color: #4e4e4e; }
    .tier-check { flex: none; width: 18px; height: 18px; margin-top: 2px; color: #f54b25; }
    @media (max-width: 767px) { .tier { padding: 28px 24px 32px; } }

    /* ----- Service-area map edge fade (service-page values) ----- */
    .area-map-fade { -webkit-mask-image: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,.12) 3%, rgba(0,0,0,.45) 6%, rgba(0,0,0,.8) 10%, #000 14%); mask-image: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,.12) 3%, rgba(0,0,0,.45) 6%, rgba(0,0,0,.8) 10%, #000 14%); }
    @media (min-width: 1024px) {
      .area-map-fade { -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,.12) 3%, rgba(0,0,0,.45) 7%, rgba(0,0,0,.8) 11%, #000 15%); mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,.12) 3%, rgba(0,0,0,.45) 7%, rgba(0,0,0,.8) 11%, #000 15%); }
    }
    .area-map-fade::before { content: ''; position: absolute; inset: 0; z-index: 450; pointer-events: none;
      -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px);
      -webkit-mask-image: linear-gradient(to bottom, #000 0%, rgba(0,0,0,.55) 4%, rgba(0,0,0,.2) 8%, transparent 11%);
      mask-image: linear-gradient(to bottom, #000 0%, rgba(0,0,0,.55) 4%, rgba(0,0,0,.2) 8%, transparent 11%); }
    @media (min-width: 1024px) {
      .area-map-fade::before { -webkit-mask-image: linear-gradient(to right, #000 0%, rgba(0,0,0,.55) 4%, rgba(0,0,0,.2) 9%, transparent 12%);
        mask-image: linear-gradient(to right, #000 0%, rgba(0,0,0,.55) 4%, rgba(0,0,0,.2) 9%, transparent 12%); }
    }

    /* ----- Local expertise (dark "ground conditions" band) ----- */
    /* Intro prose sets up the conditions below it, so it reads a size larger. */
    .local-prose > p { margin-top: 15px; font-size: 15.5px; line-height: 1.7; letter-spacing: -.012em; color: rgba(255,255,255,.62); }
    .local-prose > p:first-child { margin-top: 0; }
    .local-prose strong { font-weight: 600; color: rgba(255,255,255,.9); }

    /* Spec-sheet ledger: condition on the left, what it changes on the right.
       Three parallel forces, not a sequence — hairline rows, no numbers. */
    .lx-item { border-top: 1px solid rgba(255,255,255,.14); padding: 20px 0 4px; display: grid; gap: 6px 40px; }
    .lx-item:last-child { border-bottom: 1px solid rgba(255,255,255,.14); padding-bottom: 22px; }
    .lx-head { font-size: 15.5px; font-weight: 600; line-height: 1.35; letter-spacing: -.02em; color: #fff; }
    .lx-body { font-size: 14px; line-height: 1.7; letter-spacing: -.01em; color: rgba(255,255,255,.55); max-width: 46ch; }
    @media (min-width: 1024px) {
      .lx-item { grid-template-columns: minmax(0, 200px) minmax(0, 1fr); align-items: start; }
      .lx-head { padding-top: 1px; }
    }

    /* The photo bleeds off the right edge, floor to ceiling, and dissolves into
       the ink so there is no hard seam against the text column. */
    .lx-photo-fade { -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,.55) 12%, #000 34%); mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,.55) 12%, #000 34%); }
  </style>

  <!-- ============ 2 · HERO ============ -->
  <!-- Section 1 (visible breadcrumbs) is deliberately not rendered — the trail
       still ships as BreadcrumbList JSON-LD above. -->
  <!-- UI: service-page #hero, verbatim (video, proof badges, stat count-up). -->
  <section id="hero" class="relative min-h-screen lg:h-screen overflow-hidden text-white bg-black" data-nav-theme="dark">
    <video class="absolute inset-0 w-full h-full object-cover" muted loop playsinline preload="none" data-webm="/assets/video/hero-0715.webm" data-mp4="/assets/video/hero-0715.mp4" poster="/assets/images/hero-poster-0715.webp" aria-hidden="true" tabindex="-1"></video>
    <div class="absolute inset-0 bg-black/65"></div>

    <div class="relative z-20 h-full w-full mx-auto max-w-[1920px] px-5 sm:px-10 lg:px-[60px] flex flex-col justify-end pb-9 sm:pb-12 lg:pb-[62px] pt-[150px] gap-8 lg:gap-10">
      <div class="flex items-center gap-3.5 flex-wrap -mb-3 lg:-mb-4">
        <a href={site.social.googleMaps} target="_blank" rel="noopener noreferrer" aria-label="View our Google reviews" class="inline-block rounded-md transition-transform duration-200 ease-out hover:scale-[1.14] active:scale-[1.02] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70">
          <img src="/assets/images/google.webp" alt="Google" class="h-9 w-auto object-contain" />
        </a>
        <img src="/assets/images/bbb.webp" alt="BBB A+ rating" class="h-7 w-auto object-contain" />
        <span class="h-6 w-px bg-white/40"></span>
        <div class="flex items-center gap-1.5">
          <span class="text-[#fbbf24] text-xl tracking-tight">★★★★★</span>
          <span class="text-[15px] font-semibold uppercase">5.0</span>
        </div>
      </div>

      <div class="font-semibold capitalize leading-[1.03] tracking-[-0.03em] text-[clamp(2.75rem,6.2vw,5.5rem)]">
        <h1>
          <span>{d.heroCity}</span><br />
          <span class="text-brand block">{d.heroService}</span>
        </h1>
        <div class="flex flex-col sm:flex-row sm:items-end gap-3 sm:gap-8">
          <span>Experts</span>
          <p class="sm:mb-3 text-[14px] font-medium normal-case leading-[1.25] tracking-[-0.02em] text-[#f0f0f0] max-w-[480px]">{d.heroSubhead}</p>
        </div>
      </div>

      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8">
        <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4 w-full sm:w-auto">
          <a href="#estimate" class="btn js-open-estimate w-full sm:w-auto text-center bg-brand hover:bg-[#c23c18] rounded-full px-8 py-3.5 text-[18px] font-semibold capitalize text-white">Get a Free estimate</a>
          <a href={site.phoneHref} class="btn w-full sm:w-auto text-center border border-[#a3a3a3] hover:border-white hover:bg-white/10 rounded-full px-8 py-3.5 text-[18px] font-semibold capitalize text-[#f2f2f2]">call now</a>
        </div>
        <div class="grid grid-cols-3 gap-x-3 sm:gap-x-8 gap-y-5 lg:flex lg:flex-wrap lg:justify-end">
          {d.stats.map((s) => (
            <div class="flex flex-col items-start lg:items-end">
              <span class="font-normal text-[1.9rem] sm:text-[clamp(2.55rem,4.2vw,3.8rem)] leading-[1.085] tracking-[-0.04em]"><span class="stat-num" data-count={s.count}>{s.count}</span>{s.suffix}</span>
              <span class="font-poppins text-[11px] sm:text-[16.5px] font-medium capitalize text-[#e9e9e9] tracking-[-0.03em] leading-[1.25]">
                {/* " | " marks the phone-only line break, same as the service pages. */}
                {s.label.split('|').map((part, i) => (
                  <>{i > 0 && <br class="sm:hidden" />}{i > 0 ? ' ' : ''}{part.trim()}</>
                ))}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 3 · TRUST, 3 CARDS ============ -->
  <!-- UI: home-page #benefits card grid, verbatim — bordered container on
       #faf9f8, 88px outline-circle icon, title pinned below it. -->
  <section id="trust" class="bg-white" data-nav-theme="light">
    <div class="mx-auto max-w-[1920px] px-5 sm:px-10 lg:px-[60px] pt-16 lg:pt-20 pb-20 lg:pb-24">
      <div class="grid md:grid-cols-3 border border-black/10 bg-[#faf9f8]">
        {d.trust.map((c, i) => (
          <div class:list={[
            'flex flex-col p-6 sm:p-8 lg:p-9',
            i > 0 && 'border-t md:border-t-0 md:border-l border-black/10',
          ]}>
            <span class="grid place-items-center h-12 w-12 md:h-16 md:w-16 rounded-full border border-brand/40 text-brand">
              <svg class="w-5 h-5 md:w-7 md:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[c.icon]} />
            </span>
            <div class="mt-6 md:mt-14">
              <h2 class="text-[1.25rem] md:text-[clamp(1.35rem,1.55vw,1.6rem)] font-semibold tracking-[-0.03em]">{c.title}</h2>
              <p class="mt-2.5 text-[14px] leading-[1.6] text-graycard max-w-[340px]">{c.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 4 · WHAT'S INCLUDED ============ -->
  <!-- UI: service-page #included tile grid + .feat-check row for the permit line. -->
  <section id="included" class="bg-white" data-nav-theme="light">
    <div class="mx-auto max-w-[1920px] px-5 sm:px-10 lg:px-[60px] pt-16 lg:pt-20 pb-28 lg:pb-[150px]">
      <h2 class="font-semibold capitalize leading-[1.05] tracking-[-0.04em] text-[clamp(2.5rem,4vw,3.75rem)]">{d.includedTitle}</h2>
      <p class="mt-5 text-[15px] leading-[1.6] tracking-[-0.01em] text-graydesc max-w-[620px]">{d.includedIntro}</p>

      {/* Card count follows the matching service page: tile/flooring run 3-up,
          showers 4-up. */}
      <div class:list={['mt-12 lg:mt-16 grid gap-3 sm:grid-cols-2', d.included.length === 3 ? 'lg:grid-cols-3' : 'lg:grid-cols-4']}>
        {d.included.map((it) => (
          <article class="svc-tile">
            <div class="svc-figure">
              <img class="svc-img" src={it.image} alt={it.alt} loading="lazy" decoding="async" />
            </div>
            <h3 class="svc-title">{it.title}</h3>
            <p class="svc-desc">{it.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 5 · ★ LOCAL EXPERTISE ============ -->
  <!-- The one section on the page that is unique to this city, so it gets the
       page's only ink band: photo bleeding off the right edge, conditions read
       as a spec sheet rather than a paragraph list. -->
  <section id="local" class="relative bg-[#0f0f0f] text-white overflow-hidden" data-nav-theme="dark">
    <!-- Desktop: full-height bleed. Mobile gets the same photo below the text. -->
    <img
      loading="lazy" decoding="async" src={d.localImage} alt={d.localImageAlt}
      class="lx-photo-fade hidden lg:block absolute right-0 top-0 h-full w-[42%] object-cover" />

    <div class="relative mx-auto max-w-[1920px] px-5 sm:px-10 lg:px-[60px] pt-24 lg:pt-[160px] pb-24 lg:pb-[160px] lg:pr-[calc(42%+40px)]">
      <h2 class="font-semibold leading-[1.08] tracking-[-0.035em] text-[clamp(2rem,3vw,2.9rem)]">
        {/* A " | " in the title is an explicit line break — desktop only, so
            narrow screens still wrap on their own. */}
        {d.localTitle.split('|').map((part, i) => (
          <>{i > 0 && <br class="hidden lg:block" />}{i > 0 ? ' ' : ''}{part.trim()}</>
        ))}
      </h2>

      <div class="local-prose mt-5 max-w-[560px]"><Content /></div>

      <div class="mt-9 lg:mt-12">
        {d.localPoints.map((pt) => (
          <div class="lx-item">
            <h3 class="lx-head">{pt.title}</h3>
            <p class="lx-body">{pt.body}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="lg:hidden -mt-2">
      <img loading="lazy" decoding="async" src={d.localImage} alt={d.localImageAlt}
        class="w-full aspect-[16/11] object-cover" />
    </div>
  </section>

  <!-- ============ 6 · ★ A PROJECT HERE ============ -->
  <!-- UI: full-bleed project photo + the stat strip. -->
  <section id="project" class="bg-[#f6f5f3]" data-nav-theme="light">
    <div class="mx-auto max-w-[1920px] px-5 sm:px-10 lg:px-[60px] pt-24 lg:pt-[140px] pb-10 lg:pb-14">
      <h2 class="font-bold text-ink leading-[1.05] tracking-[-0.03em] text-[clamp(2.4rem,5vw,4rem)]">
        A recent project in {d.project.neighborhood}
      </h2>
      <p class="mt-5 text-[15.5px] leading-[1.75] text-graydesc max-w-[680px]">{d.project.story}</p>
    </div>

    <figure class="proj-photo">
      <img loading="lazy" decoding="async" src={d.project.image} alt={d.project.imageAlt} class="w-full h-full object-cover" />
    </figure>

    <div class="mx-auto max-w-[1920px] px-5 sm:px-10 lg:px-[60px] pb-20 lg:pb-[100px]">
      <!-- Four scannable facts as a stat strip. -->
      <dl class="mt-12 lg:mt-16 grid grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-9">
        <div class="spec-stat">
          <dt class="spec-label">Neighborhood</dt>
          <dd class="spec-value">{d.project.neighborhood}</dd>
        </div>
        <div class="spec-stat">
          <dt class="spec-label">Year</dt>
          <dd class="spec-value">{d.project.year}</dd>
        </div>
        <div class="spec-stat">
          <dt class="spec-label">Timeline</dt>
          <dd class="spec-value">{d.project.timeline}</dd>
        </div>
        <div class="spec-stat">
          <dt class="spec-label">Budget</dt>
          <dd class="spec-value">{d.project.budget}</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ============ 7 · REVIEWS ============ -->
  <!-- UI: service-page #reviews carousel, data swapped for this city + service. -->
  <section id="reviews" class="bg-white" data-nav-theme="light">
    <div class="mx-auto max-w-[1920px] px-5 sm:px-10 lg:px-[60px] pt-20 lg:pt-[110px] pb-8 lg:pb-12 overflow-hidden">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="lg:order-1 order-2">
          <figure class="rev-fade">
            <blockquote class="font-bold text-ink text-[clamp(0.98rem,1.8vw,1.7rem)] leading-[1.35] tracking-[-0.02em]">
              <span class="text-brand inline-block align-text-top text-[1.7em] leading-[0.7] mr-1" aria-hidden="true">&#8220;</span><span id="revQuote">{d.reviews[0]?.quote}</span>
            </blockquote>
          </figure>
          <div id="revMeta" class="mt-10 rev-fade flex items-center gap-4">
            <a href={site.social.googleMaps} target="_blank" rel="noopener noreferrer" aria-label="Read our reviews on Google" class="btn relative block h-14 w-14 shrink-0 rounded-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand/60">
              <img loading="lazy" decoding="async" id="revAvatar" src={d.reviews[0]?.avatar} alt="" class="h-14 w-14 rounded-full object-cover border border-black/10" />
              <span class="absolute -bottom-0.5 -right-0.5 grid place-items-center h-6 w-6 rounded-full bg-white shadow-[0_1px_4px_rgba(0,0,0,0.18)] ring-1 ring-black/5">
                <svg class="h-3.5 w-3.5" viewBox="0 0 48 48" aria-hidden="true">
                  <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                  <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                  <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                  <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                </svg>
              </span>
            </a>
            <div>
              <p id="revName" class="font-semibold text-[18px] tracking-[-0.01em] text-ink">{d.reviews[0]?.name}</p>
              <p id="revRole" class="mt-1 text-[15px] text-graydesc">{d.reviews[0]?.neighborhood}</p>
            </div>
          </div>
        </div>
        <div class="lg:order-2 order-1 w-full overflow-hidden aspect-[4/3] rev-fade">
          <img loading="lazy" decoding="async" id="revImg" src={d.reviews[0]?.image} alt="Completed VL Proconstruction shower" class="w-full h-full object-cover" />
        </div>
      </div>
      <div class="mt-8 lg:mt-10 flex items-center justify-center gap-3">
        <button id="revPrev" aria-label="Previous review" class="btn hidden lg:grid place-items-center h-12 w-12 rounded-full border border-black/10 text-ink hover:border-brand hover:text-brand">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <div id="revDots" class="flex lg:hidden items-center gap-2" role="tablist" aria-label="Choose a review"></div>
        <button id="revNext" aria-label="Next review" class="btn hidden lg:grid place-items-center h-12 w-12 rounded-full border border-black/10 text-ink hover:border-brand hover:text-brand">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
    </div>
  </section>

  <!-- ============ 8 · PROCESS ============ -->
  <!-- UI: service-page #process sticky steps + parallax photos. -->
  <section id="process" class="bg-white" data-nav-theme="light">
    <div class="mx-auto max-w-[1920px] px-5 sm:px-10 lg:px-[60px] pt-12 lg:pt-16">
      <h2 class="font-semibold capitalize text-ink leading-[1.04] tracking-[-0.04em] text-[clamp(2.9rem,7.5vw,5.75rem)]">Our Process</h2>
    </div>
    <div class="bg-[#faf9f8] mt-10 lg:mt-14 pb-20 lg:pb-[100px]">
      <div class="mx-auto max-w-[1920px] px-5 sm:px-10 lg:px-[60px]">
        <div class="border-b border-black/10">
          {d.process.map((s, i) => (
            <div class:list={['process-step grid grid-cols-1 md:grid-cols-[1.4fr_auto_1.3fr] gap-x-8 gap-y-4 md:gap-y-5 md:items-center py-8', i > 0 && 'border-t border-black/10']}>
              <div class="px-frame w-full sm:w-[420px] aspect-[16/11]">
                <img loading="lazy" decoding="async" src={s.image} alt={s.title} class="px-img" />
