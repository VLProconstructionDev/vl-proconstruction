---
import '@/styles/global.css';
import SEO from '@/components/SEO.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import EstimateWizard from '@/components/EstimateWizard.astro';
import ExitOffer from '@components/ExitOffer.astro';
import { localBusinessSchema } from '@/lib/schema';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  canonical?: string;
  /**
   * Kept for page-level intent/documentation. The navbar's actual theme comes
   * from the `data-nav-theme` attribute on each SECTION (read by the observer
   * in Header.astro) — never from <body>: a body-level attribute would always
   * contain the probe point and pin the navbar to one theme.
   */
  navTheme?: 'light' | 'dark';
}

const {
  title,
  description,
  image,
  noindex,
  schema,
  canonical,
  navTheme = 'light',
} = Astro.props;

// Always include the LocalBusiness schema site-wide, plus any page-specific schema.
const pageSchema = schema
  ? Array.isArray(schema)
    ? schema
    : [schema]
  : [];
const allSchema = [localBusinessSchema(), ...pageSchema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <!-- Google Search favicons require a square multiple of 48px — the
         original 1000px logo png fails that; 96px + root /favicon.ico pass. -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/assets/images/favicon-96.png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/assets/images/apple-touch-icon.png" />

    <!-- Fonts are self-hosted (@font-face in global.css, files in /assets/fonts)
         — no render-blocking Google Fonts request. Inter is a single variable
         file (wght 300–800) covering every weight the site uses; Poppins
         weights load on demand (~8 KB each). -->
    <link rel="preload" href="/assets/fonts/Inter-var.woff2" as="font" type="font/woff2" crossorigin />
    <!-- The hero poster is every page's above-fold visual (phones never load
         the video at all) — fetch it ahead of the below-fold image queue. -->
    <link rel="preload" href="/assets/images/hero-poster-0715.webp" as="image" fetchpriority="high" />

    <SEO
      title={title}
      description={description}
      image={image}
      noindex={noindex}
      schema={allSchema}
      canonical={canonical}
    />

    <!-- Page transition: subtle opacity crossfade on internal navigation. -->
    <style>
      html.pt-enter body { opacity: 0; }
      body.pt-fade { transition: opacity .35s ease; will-change: opacity; }
      body.pt-hide { opacity: 0; }
      @media (prefers-reduced-motion: reduce) {
        html.pt-enter body { opacity: 1; }
        body.pt-fade { transition: none; }
      }
      html.no-lenis { scroll-behavior: smooth; }
      @media (prefers-reduced-motion: reduce) { html.no-lenis { scroll-behavior: auto; } }
    </style>
    <script is:inline>
      try {
        if (
          sessionStorage.getItem('vlPT') &&
          !matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          document.documentElement.classList.add('pt-enter');
        }
      } catch (e) {}
    </script>
  </head>
  <body class="font-sans text-ink antialiased">
    <!-- Page-transition fade controller (fires on internal link clicks). -->
    <script is:inline>
      (function () {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var html = document.documentElement;
        var body = document.body;
        if (html.classList.contains('pt-enter')) {
          try { sessionStorage.removeItem('vlPT'); } catch (e) {}
          body.classList.add('pt-fade');
          requestAnimationFrame(function () {
            requestAnimationFrame(function () { html.classList.remove('pt-enter'); });
          });
        }
        document.addEventListener('click', function (e) {
          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          var a = e.target.closest && e.target.closest('a[href]');
          if (!a || a.target === '_blank' || a.hasAttribute('download')) return;
          var url;
          try { url = new URL(a.href, location.href); } catch (_) { return; }
          if (url.origin !== location.origin) return;
          if (url.pathname === location.pathname) return;
          e.preventDefault();
          try { sessionStorage.setItem('vlPT', '1'); } catch (_) {}
          body.classList.add('pt-fade');
          void body.offsetWidth;
          body.classList.add('pt-hide');
          var done = false;
          var go = function () { if (done) return; done = true; location.href = url.href; };
          body.addEventListener('transitionend', go, { once: true });
          setTimeout(go, 450);
        });
        window.addEventListener('pageshow', function (ev) {
          if (ev.persisted) {
            body.classList.remove('pt-fade', 'pt-hide');
            html.classList.remove('pt-enter');
          }
        });
      })();
    </script>

    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <EstimateWizard />

    <!-- Site-wide "Save $500" tab. The automatic exit-intent/dwell popup
         arms on the home page only — `auto` is false everywhere else. -->
    <ExitOffer auto={Astro.url.pathname === '/'} />

    <!-- Hero video: the HTML ships NO <source> elements. Desktop injects and
         plays immediately. Phones show the poster during page load (the ~2 MB
         video would own the radio and tank mobile LCP) and AUTOSTART shortly
         after the load event — or instantly on first touch, whichever comes
         first. Reduced-motion and Save-Data users keep the poster. -->
    <script is:inline>
      (function () {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (navigator.connection && navigator.connection.saveData) return;
        var started = false;
        var start = function () {
          if (started) return;
          started = true;
          var phone = matchMedia('(max-width: 767px)').matches;
          document.querySelectorAll('video[data-webm]').forEach(function (v) {
            // Service-page heroes swap to a still photo on phones — don't pull
            // the clip for a video that's display:none there.
            if (phone && v.hasAttribute('data-desktop-only')) return;
            [['data-webm', 'video/webm'], ['data-mp4', 'video/mp4']].forEach(function (p) {
              var s = document.createElement('source');
              s.src = v.getAttribute(p[0]);
              s.type = p[1];
              v.appendChild(s);
            });
            v.load();
            v.play().catch(function () {});
          });
        };
        if (matchMedia('(max-width: 767px)').matches) {
          ['touchstart', 'scroll', 'pointerdown'].forEach(function (ev) {
            addEventListener(ev, start, { once: true, passive: true });
          });
          var afterLoad = function () { setTimeout(start, 1000); };
          if (document.readyState === 'complete') afterLoad();
          else addEventListener('load', afterLoad, { once: true });
        } else {
          start();
        }
      })();
    </script>

    <!-- Smooth scroll (Lenis) — inertia + smooth anchor jumps -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/lenis@1.1.14/dist/lenis.min.js"></script>
    <script is:inline>
      (function () {
        var reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduceMotion || !window.Lenis) {
          document.documentElement.classList.add('no-lenis');
          return;
        }
        var lenis = new window.Lenis({
          duration: 1.1,
          easing: function (t) { return Math.min(1, 1.001 - Math.pow(2, -10 * t)); },
        });
        (function raf(time) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        })(0);
        // Keep the navbar theme in sync while smooth-scrolling.
        lenis.on('scroll', function () { window.vlUpdateNav && window.vlUpdateNav(); });
        // Smooth in-page anchor jumps with a navbar offset.
        document.querySelectorAll('a[href^="#"]').forEach(function (a) {
          a.addEventListener('click', function (e) {
            // Estimate CTAs open the full-screen wizard (EstimateWizard.astro),
            // whose handler registers later than this one — never scroll for them.
            if (a.classList.contains('js-open-estimate')) return;
            var id = a.getAttribute('href');
            if (!id || id.length < 2) return;
            var target = document.querySelector(id);
            if (!target) return;
            e.preventDefault();
            // Links inside the mobile menu: the open menu locks the body
            // (position: fixed), making scrolling impossible, and its own
            // close handler would restore the old scroll position anyway.
            // Close it first, then start the scroll once the unlock and
            // Lenis's internal sync have had a frame to settle.
            if (window.vlCloseMenu) window.vlCloseMenu();
            requestAnimationFrame(function () {
              requestAnimationFrame(function () {
                // While the body was locked the document's scrollable height
                // was ~0 and Lenis cached it — without a resize, scrollTo
                // clamps to that stale zero limit and goes nowhere.
                lenis.resize();
                lenis.scrollTo(target, { offset: -104 });
              });
            });
          });
        });
      })();
    </script>
    <!-- Client feedback widget (self-hosted, ~/markup). Inert unless the URL
         carries ?fb=<token>: no DOM, no listeners, not one request — so it
         ships site-wide rather than being gated on an env flag. `is:inline`
         keeps the data-project attribute (Astro would otherwise process the
         script and drop it); the widget reads the API origin off its own src. -->
    <script
      is:inline
      src="https://feedback-worker.datsykoleksandr1.workers.dev/widget.js"
      data-project="vl-proconstruction"
      defer
    ></script>
  </body>
</html>
