---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ServiceHero from '@/components/ServiceHero.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { serviceSchema, breadcrumbSchema } from '@/lib/schema';
import { site } from '@/lib/site';

interface Props {
  service: CollectionEntry<'services'>;
  /** Optional location — if provided, the page is a service × location landing page. */
  location?: CollectionEntry<'locations'>;
}

const { service, location } = Astro.props;
const { Content } = await render(service);

const s = service.data;
const l = location?.data;

// Location-scoped titles when a location is provided, otherwise plain service page.
const title = l
  ? `${s.shortName} in ${l.name}, ${l.state}`
  : s.seoTitle ?? s.title;

const description = l
  ? `${s.shortName} installation and remodeling in ${l.name}, ${l.state}. ${s.description}`
  : s.seoDescription ?? s.description;

const canonical = l
  ? `/services/${service.id}/${location!.id}`
  : `/services/${service.id}`;

// Breadcrumbs — grows an extra level when scoped to a location.
const crumbs = l
  ? [
      { name: 'Home', url: '/' },
      { name: 'Services', url: '/services' },
      { name: s.shortName, url: `/services/${service.id}` },
      { name: `${l.name}, ${l.state}` },
    ]
  : [
      { name: 'Home', url: '/' },
      { name: 'Services', url: '/services' },
      { name: s.shortName },
    ];

// Schema stack: Service + Breadcrumbs (always), FAQPage if FAQs exist.
const schema: Record<string, unknown>[] = [
  serviceSchema({
    name: title,
    description,
    slug: service.id,
    areaServed: l ? `${l.name}, ${l.state}` : undefined,
  }),
  breadcrumbSchema(crumbs.map((c) => ({ name: c.name, url: c.url ?? canonical }))),
];

if (s.faqs.length > 0) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: s.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.a,
      },
    })),
  });
}
---

<BaseLayout
  title={title}
  description={description}
  image={s.heroImage}
  canonical={canonical}
  schema={schema}
  navTheme="dark"
>
  <ServiceHero
    eyebrow={l ? `${l.name}, ${l.state}` : 'Service'}
    title={title}
    description={description}
    image={s.heroImage}
  />

  <div class="mx-auto max-w-[1200px] px-5 sm:px-10 pt-10">
    <Breadcrumbs items={crumbs} />
  </div>

  {l?.intro && (
    <section class="mx-auto max-w-[1200px] px-5 sm:px-10 mt-16">
      <p class="text-lg text-graydesc leading-[1.7] max-w-[820px]">
        {l.intro}
      </p>
      {l.neighborhoods.length > 0 && (
        <div class="mt-8">
          <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-graycard">
            Neighborhoods we serve
          </p>
          <div class="mt-3 flex flex-wrap gap-2">
            {l.neighborhoods.map((n) => (
              <span class="inline-flex items-center h-8 px-3.5 rounded-full border border-black/10 text-[13px] text-ink">
                {n}
              </span>
            ))}
          </div>
        </div>
      )}
    </section>
  )}

  {s.features.length > 0 && (
    <section class="mx-auto max-w-[1200px] px-5 sm:px-10 mt-20">
      <h2 class="text-3xl sm:text-4xl font-semibold tracking-[-0.02em]">
        What's included
      </h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2">
        {s.features.map((f) => (
          <li class="flex items-start gap-3 rounded-2xl border border-black/10 bg-white p-5">
            <span
              aria-hidden="true"
              class="mt-0.5 grid place-items-center h-6 w-6 rounded-full bg-brand/10 text-brand shrink-0"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg>
            </span>
            <span class="text-[15px] text-ink leading-[1.5]">{f}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {s.included.length > 0 && (
    <section class="mx-auto max-w-[1200px] px-5 sm:px-10 mt-20">
      <h2 class="text-3xl sm:text-4xl font-semibold tracking-[-0.02em]">
        Our approach
      </h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {s.included.map((card) => (
          <article class="overflow-hidden rounded-2xl border border-black/10 bg-white">
            {card.image && (
              <div class="aspect-[4/3] overflow-hidden">
                <img
                  src={card.image}
                  alt={card.title}
                  class="h-full w-full object-cover"
                  loading="lazy"
                />
              </div>
            )}
            <div class="p-6">
              <h3 class="text-xl font-semibold tracking-[-0.02em]">{card.title}</h3>
              <p class="mt-2 text-[15px] text-graydesc leading-[1.6]">{card.body}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="mx-auto max-w-[820px] px-5 sm:px-10 mt-20 prose prose-lg prose-headings:tracking-[-0.02em] prose-a:text-brand">
    <Content />
  </section>

  {s.faqs.length > 0 && (
    <section id="faqs" class="mx-auto max-w-[820px] px-5 sm:px-10 mt-20">
      <h2 class="text-3xl sm:text-4xl font-semibold tracking-[-0.02em]">
        Frequently asked questions
      </h2>
      <div class="mt-6 divide-y divide-black/10 border-y border-black/10">
        {s.faqs.map((f) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[17px] font-medium text-ink">
              <span>{f.q}</span>
              <svg
                class="w-5 h-5 shrink-0 text-graycard transition-transform group-open:rotate-180"
                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              >
                <path d="m6 9 6 6 6-6"/>
              </svg>
            </summary>
            <p class="mt-3 text-[15px] text-graydesc leading-[1.7]">{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  )}

  <section id="estimate" class="mx-auto max-w-[1200px] px-5 sm:px-10 my-24">
    <div class="rounded-3xl bg-ink text-white p-10 sm:p-14">
      <p class="text-[12px] font-semibold uppercase tracking-[0.18em] text-brand">
        Get started
      </p>
      <h2 class="mt-3 text-3xl sm:text-5xl font-semibold tracking-[-0.03em] max-w-[720px]">
        {l
          ? `Ready to start your ${s.shortName.toLowerCase()} project in ${l.name}?`
          : `Ready to start your ${s.shortName.toLowerCase()} project?`}
      </h2>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="#estimate"
          class="btn js-open-estimate inline-flex items-center h-12 px-7 rounded-full bg-brand hover:bg-[#e03f1c] text-white font-semibold text-[15px] capitalize"
        >
          Get a Free Estimate
        </a>
        <a
          href={site.phoneHref}
          class="btn inline-flex items-center h-12 px-6 rounded-full border border-white/20 hover:border-white text-white font-medium text-[15px]"
        >
          Call {site.phone}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
