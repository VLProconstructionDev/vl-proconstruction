---
import { site } from '@/lib/site';

const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const H = isHome ? '' : '/';

const currentYear = new Date().getFullYear();

const serviceAreas = [
  'Bradenton', 'Sarasota', 'Parrish', 'Manatee County', 'Sarasota County',
  'Ellenton', 'Palmetto', 'Lakewood Ranch', 'University Park', 'Nokomis',
  'Venice', 'Anna Maria', 'Holmes Beach', 'Bradenton Beach', 'Longboat Key',
  'Siesta Key',
];

/* The eight the column lists; the rest still ship in the "Serving" run above the
   copyright bar, so no area drops out of the page. None of these are links —
   there is no per-city landing page yet, only city x service pages, so the
   column points at /locations/ instead of inventing routes. */
const primaryAreas = serviceAreas.slice(0, 8);

/* Claims the rest of the site already makes: the hero stats, the credential
   marks, and the pricing sections. Nothing new is promised here. */
const whyChooseUs = [
  'Licensed &amp; Insured',
  'Schluter&reg;-Certified Installers',
  'NTCA Member',
  'Family-Owned &amp; Operated',
  '22+ Years of Experience',
  '100% Warranty Coverage',
  'Free Written Estimates',
];

/* Supplier partners. Dedicated white variants rather than a CSS invert: the
   marks carry knocked-out shapes (the "&" inside Floor & Decor's plate, the
   quadrants of the Tile Outlets diamond) and `brightness(0) invert(1)` flattens
   those into solid white blocks. The -white files keep each logo's alpha and
   paint the visible pixels white. ProSource has no logo file anywhere in the
   project, so this repeats the two-line type lockup the home page uses instead
   of inventing a mark. Heights are per-brand — these aspect ratios differ
   enough that one shared height makes the wide marks look twice the size. */
const partners = [
  { src: '/assets/images/brand/floordecor-white.svg', alt: 'Floor & Decor', h: 'h-[17px]' },
  { src: '/assets/images/brand/tileoutlets-white.webp', alt: 'Tile Outlets of America', h: 'h-[20px]' },
  { type: 'prosource', alt: 'ProSource Wholesale' },
  { src: '/assets/images/brand/yourflooring-white.webp', alt: 'Your Flooring Warehouse', h: 'h-[29px]' },
];
---

<footer class="bg-black text-white" data-nav-theme="dark">
  <div class="mx-auto max-w-[1920px] px-5 sm:px-10 lg:px-[60px] pt-14 lg:pt-16 pb-32 lg:pb-[190px]">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-4 lg:gap-y-12 lg:gap-x-20">

      <div>
        <p class="text-[15px] font-medium text-white">
          Serving Florida since 2004
        </p>
        <img src="/assets/images/logo.svg" alt={site.name} class="mt-6 h-[58px] w-auto" />

        {/* Non-breaking space before each separator, so a wrapped line never
            starts with a stray "·"; non-breaking hyphen (&#8209;) in
            "Family-Owned" so it cannot break across lines as "Family-/Owned" */}
        <p class="mt-5 max-w-[300px] text-[11px] font-semibold capitalize leading-[2] tracking-[0.12em] text-white/40">
          Florida Licensed General Contractor<br />
          Bonded &amp; Insured&nbsp;· Family&#8209;Owned &amp; Operated
        </p>

        <div class="mt-10 max-w-[300px]">
          <div class="h-px bg-white/10"></div>

          {/* Credential marks, laid out like the hero's: the logo carries the
              claim, so the label beside it names what the badge means. The
              white-on-transparent artwork needs no plate behind it. */}
          <p class="mt-10 text-[15px] font-medium text-white">
            Certifications &amp; Memberships
          </p>
          <div class="mt-6 flex items-center gap-6">
            <div class="flex items-center gap-3">
              <img
                src="/assets/images/brand/schluter-white.webp"
                width="408"
                height="240"
                alt=""
                loading="lazy"
                decoding="async"
                class="block h-7 w-auto opacity-90"
              />
              <p class="shrink-0 text-[13px] font-medium leading-[1.25] tracking-[-0.02em] text-white/70">
                Schluter&reg;<br />Certified
              </p>
            </div>
            <span class="h-7 w-px shrink-0 bg-white/15" aria-hidden="true"></span>
            <div class="flex items-center gap-3">
              <img
                src="/assets/images/brand/ntca-white.webp"
                width="240"
                height="240"
                alt=""
                loading="lazy"
                decoding="async"
                class="block h-10 w-auto opacity-90"
              />
              <p class="shrink-0 text-[13px] font-medium leading-[1.25] tracking-[-0.02em] text-white/70">
                NTCA<br />Member
              </p>
            </div>
          </div>

          <p class="mt-10 text-[15px] font-medium text-white">
            Our Partners
          </p>
          {/* 2×2 grid, not a flex row: four marks across a 420px column would
              sit a few pixels from overflowing at every breakpoint. */}
          <ul class="mt-6 grid grid-cols-2 gap-x-5 gap-y-2 max-w-[280px]">
            {partners.map((partner) => (
              <li class="flex h-8 items-center">
                {partner.type === 'prosource' ? (
                  <span
                    class="inline-flex flex-col items-center leading-none text-white/60"
                    aria-label={partner.alt}
                  >
                    <span class="text-[13px] font-extrabold tracking-[-0.02em]">ProSource</span>
                    <span class="mt-1 text-[6px] font-semibold tracking-[0.34em]">WHOLESALE</span>
                  </span>
                ) : (
                  <img
                    src={partner.src}
                    alt={partner.alt}
                    loading="lazy"
                    decoding="async"
                    class:list={['block w-auto opacity-60', partner.h]}
                  />
                )}
              </li>
            ))}
          </ul>

          <p class="mt-10 text-[15px] font-medium text-white">Why choose us</p>
          {/* Checks, not bullets: each line is a credential the visitor can verify,
              so the mark reads as a tick-off rather than decoration. */}
          <ul class="mt-6 space-y-4 text-[15px] text-white/70">
            {whyChooseUs.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="mt-[5px] h-[13px] w-[13px] shrink-0 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                <span set:html={item} />
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div>
        <p class="text-[15px] font-medium text-white">Navigate</p>
        <ul class="mt-6 space-y-4 text-[15px] text-white/70">
          <li><a href={`${H}#services`} class="hover:text-brand transition-colors">Services</a></li>
          <li><a href={`${H}#gallery`} class="hover:text-brand transition-colors">Our Work</a></li>
          <li><a href={`${H}#reviews`} class="hover:text-brand transition-colors">Reviews</a></li>
          <li><a href={`${H}#process`} class="hover:text-brand transition-colors">Our Process</a></li>
          <li><a href={`${H}#benefits`} class="hover:text-brand transition-colors">Why VL Pro</a></li>
          <li><a href="/locations/" class="hover:text-brand transition-colors">Service Locations</a></li>
          <li><a href={`${H}#faqs`} class="hover:text-brand transition-colors">FAQ</a></li>
          <li><a href="#estimate" class="js-open-estimate hover:text-brand transition-colors">Free Estimate</a></li>
        </ul>

        <p class="mt-10 text-[15px] font-medium text-white">Services</p>
        <ul class="mt-6 space-y-4 text-[15px] text-white/70">
          <li><a href="/services/custom-showers/" class="hover:text-brand transition-colors">Custom Showers</a></li>
          <li><a href="/services/bathroom-remodeling/" class="hover:text-brand transition-colors">Bathroom Remodeling</a></li>
          <li><a href="/services/tile-natural-stone/" class="hover:text-brand transition-colors">Tile &amp; Natural Stone</a></li>
          <li><a href="/services/flooring/" class="hover:text-brand transition-colors">Flooring</a></li>
        </ul>

        <p class="mt-10 text-[15px] font-medium text-white">Resources</p>
        <ul class="mt-6 space-y-4 text-[15px] text-white/70">
          <li><a href="/blog/" class="hover:text-brand transition-colors">Blog</a></li>
        </ul>
      </div>

      <div>
        <p class="text-[15px] font-medium text-white">Areas served</p>
        <ul class="mt-6 space-y-4 text-[15px] text-white/70">
          {primaryAreas.map((area) => <li>{area}</li>)}
        </ul>
        <a href="/locations/" class="btn mt-6 inline-flex items-center gap-2 text-[15px] text-brand hover:text-[#ff6a45]">
          View all service areas
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>

      <div>
        <p class="text-[15px] font-medium text-white">Get in touch</p>

        {/* No per-field eyebrows — a phone number, an email and a street
            address each read as what they are without a label. */}
        <ul class="mt-6 space-y-4 text-[15px] text-white/70">
          <li>
            <a href={site.phoneHref} class="inline-block hover:text-brand transition-colors">
              {site.phone}
            </a>
          </li>
          <li>
            <a href={`mailto:${site.email}`} class="inline-block hover:text-brand transition-colors">
              {site.email}
            </a>
          </li>
          <li>
            <a
              href={site.social.googleMaps}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Open ${site.name}'s address in Google Maps`}
              class="inline-block max-w-[300px] leading-[1.6] hover:text-brand transition-colors"
            >
              {site.address.streetAddress}, {site.address.addressLocality}, {site.address.addressRegion} {site.address.postalCode}
            </a>
          </li>
        </ul>

        <p class="mt-10 text-[15px] font-medium text-white">Office hours</p>
        <p class="mt-6 text-[15px] leading-[1.6] text-white/70">{site.hours.office}</p>

        <p class="mt-10 text-[15px] font-medium text-white">Emergency services</p>
        <p class="mt-6 text-[15px] leading-[1.6] text-white/70">{site.hours.emergency}</p>

        <div class="mt-7 h-px bg-white/10"></div>

        <div class="mt-7 flex items-center gap-3">
          <a
            href={site.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Follow ${site.name} on Instagram`}
            class="btn grid place-items-center h-11 w-11 rounded-lg bg-white/5 text-white/70 hover:bg-white/10 hover:text-white"
          >
            <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
            </svg>
          </a>
        </div>
      </div>

    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="mcta-clear mx-auto max-w-[1920px] px-4 sm:px-10 lg:px-[60px] py-5 flex flex-row items-center justify-between gap-2 sm:gap-3">
      {/* Phone type scales with the viewport so the full line + pill never wrap */}
      <p class="text-[clamp(0.5rem,2.45vw,0.8125rem)] tracking-[-0.01em] text-white/50 whitespace-nowrap">
        All Rights Reserved © {site.name} {currentYear}
      </p>
      <a
        href="https://synertech.ai"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Built by Synertech — opens synertech.ai in a new tab"
        class="synertech btn inline-flex shrink-0 items-center gap-1.5 sm:gap-2.5 rounded-full border border-white/15 bg-white/[0.04] pl-2.5 sm:pl-3.5 pr-1 py-1 font-poppins text-[clamp(0.625rem,2.4vw,0.8125rem)] text-white/60 whitespace-nowrap"
      >
        <span>Built by <span class="font-bold text-white">synertech</span></span>
        <span class="synertech-mark grid place-items-center h-[clamp(1.375rem,5.9vw,1.625rem)] w-[clamp(1.375rem,5.9vw,1.625rem)] rounded-full bg-white text-black">
          <svg class="w-[clamp(0.625rem,2.7vw,0.75rem)] h-auto" viewBox="0 0 36 41" fill="currentColor" aria-hidden="true">
            <path d="M3.58013 12.665L0 19.0545H7.16026L0 31.7195H7.16026L17.8447 12.665L3.58013 12.665Z"/>
            <path d="M32.2601 12.4141L28.5091 6.12739L25.0448 12.5181L17.6407 -0.000132421L14.1764 6.39061L25.3586 25.1457L32.2601 12.4141Z"/>
            <path d="M18.0064 37.8314L25.2224 37.8254L21.6648 31.4882L35.9997 31.5329L32.4421 25.1956L10.9191 25.2065L18.0064 37.8314Z"/>
          </svg>
        </span>
      </a>
    </div>
  </div>
</footer>

<style is:global>
  /* Attribution pill — only transform/color animate, never `transition-all` */
  .synertech {
    transition: border-color 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }
  .synertech-mark {
    transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .synertech:hover {
    border-color: rgba(255, 255, 255, 0.35);
    background-color: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.85);
  }
  .synertech:hover .synertech-mark {
    transform: rotate(-12deg);
  }
  .synertech:focus-visible {
    outline: 2px solid #f54b25;
    outline-offset: 3px;
  }
  .synertech:active {
    transform: scale(0.98);
  }
  @media (prefers-reduced-motion: reduce) {
    .synertech,
    .synertech-mark {
      transition: none;
    }
    .synertech:hover .synertech-mark,
    .synertech:active {
      transform: none;
    }
  }
</style>
