---
interface Crumb {
  name: string;
  url?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-[13px] text-graycard">
  <ol class="flex flex-wrap items-center gap-1.5">
    {items.map((item, i) => (
      <li class="flex items-center gap-1.5">
        {item.url && i < items.length - 1 ? (
          <a
            href={item.url}
            class="hover:text-brand transition-colors underline-offset-4 hover:underline"
          >
            {item.name}
          </a>
        ) : (
          <span class="text-ink">{item.name}</span>
        )}
        {i < items.length - 1 && (
          <span aria-hidden="true" class="text-graycard/60">/</span>
        )}
      </li>
    ))}
  </ol>
</nav>
